@model Cedeva.Website.Features.ActivityManagement.ViewModels.PresenceSummaryViewModel
@{
    ViewData["Title"] = Localizer["ActivityManagement.PresenceSummary"] + " - " + Model.Activity.Name;
    ViewData["ActivityId"] = Model.Activity.Id;
    ViewData["ActivityName"] = Model.Activity.Name;
    ViewData["NavSection"] = "PresenceSummary";
    var culture = new System.Globalization.CultureInfo("fr-FR");
}

<div class="container-fluid py-4">
    @await Html.PartialAsync("_AlertMessages")

    <h2 class="text-primary fw-bold mb-4">
        @Localizer["ActivityManagement.PresenceSummary"]
    </h2>

    @if (!Model.Weeks.Any())
    {
        <div class="alert alert-info">
            <i class="fas fa-info-circle"></i> @Localizer["ActivityManagement.NoActiveDay"]
        </div>
    }
    else
    {
        @foreach (var week in Model.Weeks)
        {
            <div class="table-responsive mb-4">
                <table class="table table-borderless mb-0 presence-summary-table">
                    <thead>
                        <tr>
                            <th scope="col" class="fs-5 fw-bold text-dark">@Localizer["ActivityManagement.PresenceSummary.Week", week.WeekNumber]</th>
                            <th scope="col" class="text-muted fw-normal">@Localizer["ActivityManagement.PresenceSummary.Reserved"]</th>
                            <th scope="col" class="text-muted fw-normal">@Localizer["ActivityManagement.PresenceSummary.MD"]</th>
                            <th scope="col" class="text-muted fw-normal">@Localizer["ActivityManagement.PresenceSummary.HLe"]</th>
                            <th scope="col" class="text-muted fw-normal">@Localizer["ActivityManagement.PresenceSummary.HLo"]</th>
                            <th scope="col" class="fw-bold text-dark">@Localizer["ActivityManagement.PresenceSummary.TotalReserved"]</th>
                            <th scope="col" class="text-muted fw-normal">@Localizer["Present"]</th>
                            <th scope="col" class="text-muted fw-normal">@Localizer["ActivityManagement.PresenceSummary.MD"]</th>
                            <th scope="col" class="text-muted fw-normal">@Localizer["ActivityManagement.PresenceSummary.HLe"]</th>
                            <th scope="col" class="text-muted fw-normal">@Localizer["ActivityManagement.PresenceSummary.HLo"]</th>
                            <th scope="col" class="fw-bold text-dark">@Localizer["ActivityManagement.PresenceSummary.TotalPresent"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var day in week.Days)
                        {
                            <tr>
                                <td>@(char.ToUpper(day.DayDate.ToString("dddd", culture)[0]) + day.DayDate.ToString("dddd", culture).Substring(1) + " " + day.DayDate.ToString("dd/MM/yyyy"))</td>
                                <td class="text-muted">@day.ReservedRegularCount</td>
                                <td class="text-muted">@day.ReservedDisadvantagedCount</td>
                                <td class="text-muted">@day.ReservedMildDisabilityCount</td>
                                <td class="text-muted">@day.ReservedSevereDisabilityCount</td>
                                <td class="fw-bold">@day.ReservedCount</td>
                                <td>@day.PresentRegularCount</td>
                                <td class="text-muted">@day.PresentDisadvantagedCount</td>
                                <td class="text-muted">@day.PresentMildDisabilityCount</td>
                                <td class="text-muted">@day.PresentSevereDisabilityCount</td>
                                <td class="fw-bold">@day.PresentCount</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

        <div class="border-start border-3 ps-3 text-muted mt-5">
            <p class="fw-bold mb-1">@Localizer["ActivityManagement.PresenceSummary.Legend"]</p>
            <p class="mb-1">@Localizer["ActivityManagement.PresenceSummary.MD"] = @Localizer["ActivityManagement.PresenceSummary.LegendMD"]</p>
            <p class="mb-1">@Localizer["ActivityManagement.PresenceSummary.HLe"] = @Localizer["ActivityManagement.PresenceSummary.LegendHLe"]</p>
            <p class="mb-0">@Localizer["ActivityManagement.PresenceSummary.HLo"] = @Localizer["ActivityManagement.PresenceSummary.LegendHLo"]</p>
        </div>
    }
</div>

<style>
    .presence-summary-table th,
    .presence-summary-table td {
        padding: 0.65rem 0.75rem;
        border-bottom: 1px solid #eee;
    }

    .presence-summary-table thead th {
        background: none;
        text-transform: none;
        border-bottom: 1px solid #ddd;
    }

    .presence-summary-table thead th.text-muted {
        font-size: 0.85rem;
        font-weight: 400;
    }
</style>
