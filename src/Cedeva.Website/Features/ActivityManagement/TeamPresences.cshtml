@model Cedeva.Website.Features.ActivityManagement.ViewModels.TeamPresencesViewModel

@{
    ViewData["Title"] = Localizer["ActivityManagement.TeamPresences"] + " - " + Model.Activity.Name;
    ViewData["ActivityId"] = Model.Activity.Id;
    ViewData["ActivityName"] = Model.Activity.Name;
    ViewData["NavSection"] = "TeamPresences";
}

<div class="container-fluid py-4">
    @await Html.PartialAsync("_AlertMessages")
    <!-- Sélection du jour -->
    <div class="card mb-4">
        <div class="card-body">
            <form asp-action="TeamPresences" method="get" class="row g-3 align-items-end">
                <input type="hidden" name="id" value="@Model.Activity.Id" />
                <div class="col-md-6">
                    <label for="dayId" class="form-label fw-bold">@Localizer["ActivityManagement.SelectDay"]</label>
                    <select name="dayId" id="dayId" class="form-select">
                        @if (!Model.ActivityDayOptions.Any())
                        {
                            <option value="">@Localizer["ActivityManagement.NoActiveDay"]</option>
                        }
                        else
                        {
                            @foreach (var option in Model.ActivityDayOptions)
                            {
                                <option value="@option.Value" selected="@option.Selected">@option.Text</option>
                            }
                        }
                    </select>
                </div>
            </form>
        </div>
    </div>

    @if (Model.SelectedActivityDay != null)
    {
        @if (!Model.TeamMembers.Any())
        {
            <div class="alert alert-info">
                <i class="fas fa-info-circle"></i> @Localizer["ActivityManagement.NoTeamMembersAssigned"]
            </div>
        }
        else
        {
            <div class="card">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">
                        <i class="fas fa-user-check"></i> @Localizer["ActivityManagement.TeamPresences"]
                        <span class="badge bg-light text-dark ms-2">@Model.TeamMembers.Count @Localizer["ActivityManagement.TeamMembersCount"]</span>
                    </h5>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th scope="col">@Localizer["LastName"]</th>
                                    <th scope="col">@Localizer["FirstName"]</th>
                                    <th scope="col">@Localizer["Field.Role"]</th>
                                    <th scope="col" class="text-center">@Localizer["Present"]</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var teamMember in Model.TeamMembers)
                                {
                                    <tr class="@(teamMember.IsPresent ? "table-success" : "")">
                                        <td>@teamMember.LastName</td>
                                        <td>@teamMember.FirstName</td>
                                        <td>@Localizer[$"TeamRole.{teamMember.TeamRole}"]</td>
                                        <td class="text-center">
                                            @if (teamMember.TeamMemberDayId.HasValue)
                                            {
                                                <div class="form-check d-inline-block">
                                                    <input type="checkbox"
                                                           class="form-check-input team-presence-checkbox"
                                                           data-teammemberday-id="@teamMember.TeamMemberDayId.Value"
                                                           @(teamMember.IsPresent ? "checked" : "")
                                                           style="cursor: pointer;" />
                                                </div>
                                            }
                                            else
                                            {
                                                <span class="text-muted">N/A</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }
    }
    else
    {
        <div class="alert alert-warning">
            <i class="fas fa-exclamation-triangle"></i> @Localizer["ActivityManagement.SelectActivityDay"]
        </div>
    }
</div>

@section Scripts {
    @Html.AntiForgeryToken()
    <script>
        $(document).ready(function () {
            const daySelector = document.getElementById('dayId');
            if (daySelector) {
                new Choices(daySelector, {
                    searchEnabled: false,
                    itemSelectText: '',
                    shouldSort: false,
                    callbackOnInit: function() {
                        daySelector.addEventListener('change', function() {
                            this.form.submit();
                        });
                    }
                });
            }

            $('.team-presence-checkbox').on('change', function () {
                var checkbox = $(this);
                var teamMemberDayId = checkbox.data('teammemberday-id');
                var isPresent = checkbox.is(':checked');
                var row = checkbox.closest('tr');
                var token = $('input[name="__RequestVerificationToken"]').val();

                $.ajax({
                    url: '@Url.Action("UpdateTeamMemberPresence", "ActivityManagement")',
                    type: 'POST',
                    headers: {
                        'RequestVerificationToken': token
                    },
                    data: {
                        teamMemberDayId: teamMemberDayId,
                        isPresent: isPresent
                    },
                    success: function (response) {
                        if (response.success) {
                            if (isPresent) {
                                row.addClass('table-success');
                            } else {
                                row.removeClass('table-success');
                            }
                        } else {
                            alert('@Localizer["Error"]: ' + response.message);
                            checkbox.prop('checked', !isPresent);
                        }
                    },
                    error: function () {
                        alert('@Localizer["ActivityManagement.UpdateError"]');
                        checkbox.prop('checked', !isPresent);
                    }
                });
            });
        });
    </script>
}
