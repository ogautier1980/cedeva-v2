@using Cedeva.Core.Enums
@model Cedeva.Website.Features.ActivityManagement.ViewModels.TeamPresencesViewModel

@{
    ViewData["Title"] = Localizer["ActivityManagement.TeamPresences"] + " - " + Model.Activity.Name;
    ViewData["ActivityId"] = Model.Activity.Id;
    ViewData["ActivityName"] = Model.Activity.Name;
    ViewData["NavSection"] = "TeamPresences";

    var culture = new System.Globalization.CultureInfo("fr-BE");

    // Days are laid out week by week, with a thin separator column between two weeks.
    var weeks = Model.Days
        .GroupBy(d => d.Week ?? 0)
        .OrderBy(g => g.Min(d => d.DayDate))
        .Select(g => g.OrderBy(d => d.DayDate).ToList())
        .ToList();

    var roleSections = new[] { TeamRole.Coordinator, TeamRole.Animator };
}

<div class="container-fluid py-4">
    @await Html.PartialAsync("_AlertMessages")

    @if (!Model.TeamMembers.Any())
    {
        <div class="alert alert-info">
            <i class="fas fa-info-circle"></i> @Localizer["ActivityManagement.NoTeamMembersAssigned"]
        </div>
    }
    else if (!Model.Days.Any())
    {
        <div class="alert alert-warning">
            <i class="fas fa-exclamation-triangle"></i> @Localizer["ActivityManagement.NoActiveDay"]
        </div>
    }
    else
    {
        foreach (var role in roleSections)
        {
            var members = Model.TeamMembers.Where(m => m.TeamRole == role).ToList();
            if (!members.Any())
            {
                continue;
            }

            <h2 class="text-primary fw-bold mb-3">
                @Localizer[role == TeamRole.Coordinator ? "TeamPresences.Coordinators" : "TeamPresences.Animators"]
            </h2>

            <div class="table-responsive mb-5">
                <table class="table table-sm align-middle team-presence-table mb-0 w-auto">
                    <thead>
                        <tr>
                            <th scope="col" class="name-col">@Localizer["LastName"]</th>
                            <th scope="col" class="name-col">@Localizer["FirstName"]</th>
                            <th scope="col">@Localizer["Status"]</th>
                            @for (var w = 0; w < weeks.Count; w++)
                            {
                                if (w > 0)
                                {
                                    <th scope="col" class="week-gap">-</th>
                                }
                                foreach (var day in weeks[w])
                                {
                                    <th scope="col" class="text-center day-col" title="@day.DayDate.ToString("dddd dd/MM", culture)">
                                        @char.ToUpper(day.DayDate.ToString("ddd", culture)[0])
                                    </th>
                                }
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var member in members)
                        {
                            <tr>
                                <td class="fw-bold text-uppercase">
                                    <a asp-controller="TeamMembers" asp-action="Details" asp-route-id="@member.TeamMemberId"
                                       class="text-decoration-none">@member.LastName</a>
                                </td>
                                <td>@member.FirstName</td>
                                <td class="text-nowrap">
                                    @if (member.Status == Status.Compensated)
                                    {
                                        <span title="@Localizer["TeamPresences.LegendCompensated"]">€</span>
                                    }
                                    @switch (member.License)
                                    {
                                        case License.License:
                                        case License.Assimilated:
                                            <i class="fas fa-check" title="@Localizer["TeamPresences.LegendLicensed"]"></i>
                                            break;
                                        case License.Internship:
                                            <i class="fas fa-user-graduate" title="@Localizer["TeamPresences.LegendSecondCycle"]"></i>
                                            break;
                                        default:
                                            <i class="fas fa-times" title="@Localizer["TeamPresences.LegendNoLicense"]"></i>
                                            break;
                                    }
                                </td>
                                @for (var w = 0; w < weeks.Count; w++)
                                {
                                    if (w > 0)
                                    {
                                        <td class="week-gap">-</td>
                                    }
                                    foreach (var day in weeks[w])
                                    {
                                        <td class="text-center day-col">
                                            <input type="checkbox"
                                                   class="form-check-input team-presence-checkbox"
                                                   data-teammember-id="@member.TeamMemberId"
                                                   data-day-id="@day.DayId"
                                                   @(member.IsPresentOn(day.DayId) ? "checked" : "")
                                                   title="@day.DayDate.ToString("dddd dd/MM", culture)" />
                                        </td>
                                    }
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

        <a asp-action="TeamMembers" asp-route-id="@Model.Activity.Id" class="btn btn-primary">
            <i class="fas fa-plus-circle me-2"></i>@Localizer["TeamPresences.AddTeamMember"]
        </a>

        <div class="text-muted small mt-5">
            <p class="fw-bold mb-1">@Localizer["TeamPresences.Legend"]</p>
            <p class="mb-1"><i class="fas fa-check"></i> = @Localizer["TeamPresences.LegendLicensed"]</p>
            <p class="mb-1"><i class="fas fa-user-graduate"></i> = @Localizer["TeamPresences.LegendSecondCycle"]</p>
            <p class="mb-1"><i class="fas fa-times"></i> = @Localizer["TeamPresences.LegendNoLicense"]</p>
            <p class="mb-0">€ = @Localizer["TeamPresences.LegendCompensated"]</p>
        </div>
    }
</div>

<style>
    .team-presence-table thead th {
        background: none;
        text-transform: none;
        border-bottom: 1px solid #ddd;
    }

    /* Day columns stay narrow so the grid reads as a block; the name columns take the slack. */
    .team-presence-table .day-col {
        width: 2.25rem;
        padding-left: 0;
        padding-right: 0;
    }

    .team-presence-table .name-col {
        min-width: 9rem;
    }

    /* The thin column that separates two weeks. */
    .team-presence-table .week-gap {
        color: #adb5bd;
        text-align: center;
        width: 1.5rem;
        padding-left: 0;
        padding-right: 0;
    }
</style>

@section Scripts {
    @Html.AntiForgeryToken()
    <script>
        $(document).ready(function () {
            $('.team-presence-checkbox').on('change', function () {
                var checkbox = $(this);
                var isPresent = checkbox.is(':checked');

                $.ajax({
                    url: '@Url.Action("UpdateTeamMemberPresence", "ActivityManagement")',
                    type: 'POST',
                    headers: {
                        'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                    },
                    data: {
                        teamMemberId: checkbox.data('teammember-id'),
                        dayId: checkbox.data('day-id'),
                        isPresent: isPresent
                    },
                    success: function (response) {
                        if (!response.success) {
                            alert('@Localizer["Error"]: ' + response.message);
                            checkbox.prop('checked', !isPresent);
                        }
                    },
                    error: function () {
                        alert('@Localizer["ActivityManagement.UpdateError"]');
                        checkbox.prop('checked', !isPresent);
                    }
                });
            });
        });
    </script>
}
