@model Cedeva.Website.Features.ActivityManagement.ViewModels.PrintGroupsViewModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@Localizer["ActivityManagement.GroupsList"] - @Model.Activity.Name</title>
    <style>
        @@page {
            size: A4;
            margin: 1.5cm;
        }

        body {
            font-family: Arial, sans-serif;
            font-size: 11pt;
            line-height: 1.4;
        }

        .header {
            text-align: center;
            margin-bottom: 30px;
            border-bottom: 2px solid #333;
            padding-bottom: 15px;
        }

        .header h1 {
            margin: 0 0 10px 0;
            font-size: 20pt;
        }

        .header p {
            margin: 5px 0;
            font-size: 12pt;
        }

        .info-box {
            background-color: #f5f5f5;
            padding: 10px;
            margin-bottom: 20px;
            border-radius: 5px;
        }

        .info-box p {
            margin: 5px 0;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 20px;
        }

        table th {
            background-color: #333;
            color: white;
            padding: 10px 5px;
            text-align: left;
            font-weight: bold;
            border: 1px solid #333;
        }

        table td {
            padding: 8px 5px;
            border: 1px solid #ddd;
        }

        table tr:nth-child(even) {
            background-color: #f9f9f9;
        }

        .group-badge {
            background-color: #007bff;
            color: white;
            padding: 3px 8px;
            border-radius: 3px;
            font-size: 9pt;
            font-weight: bold;
        }

        .footer {
            margin-top: 30px;
            padding-top: 15px;
            border-top: 1px solid #ccc;
            font-size: 9pt;
            color: #666;
        }

        @@media print {
            .no-print {
                display: none;
            }

            body {
                print-color-adjust: exact;
                -webkit-print-color-adjust: exact;
            }
        }

        .print-button {
            position: fixed;
            top: 20px;
            right: 20px;
            padding: 10px 20px;
            background-color: #007bff;
            color: white;
            border: none;
            border-radius: 5px;
            cursor: pointer;
            font-size: 14pt;
            box-shadow: 0 2px 5px rgba(0,0,0,0.2);
        }

        .print-button:hover {
            background-color: #0056b3;
        }
    </style>
</head>
<body>
    <button onclick="window.print()" class="print-button no-print">
        🖨️ @Localizer["Print"]
    </button>

    <div class="header">
        <h1>@Localizer["ActivityManagement.GroupsList"]</h1>
        <p><strong>@Model.Activity.Name</strong></p>
        @if (Model.Group != null)
        {
            <p>@Localizer["Activities.Group"]: <strong>@Model.Group.Label</strong></p>
        }
        @if (Model.ActivityDay != null)
        {
            <p>@Model.ActivityDay.DayDate.ToString("dddd dd MMMM yyyy", new System.Globalization.CultureInfo("fr-FR"))</p>
        }
    </div>

    <div class="info-box">
        <p><strong>@Localizer["Presence.TotalChildren"]</strong> @Model.Children.Count</p>
        <p><strong>@Localizer["Presence.PrintDate"]</strong> @DateTime.Now.ToString("dd/MM/yyyy HH:mm")</p>
    </div>

    @if (!Model.Children.Any())
    {
        <p style="text-align: center; font-style: italic; color: #666;">
            @Localizer["Presence.NoBookings"]
        </p>
    }
    else
    {
        <table>
            <thead class="table-light">
                <tr>
                    <th scope="col" style="width: 80px">@Localizer["Group"]</th>
                    <th scope="col">@Localizer["FullName"]</th>
                    <th scope="col" style="width: 100px">@Localizer["Presence.BirthDateShort"]</th>
                    <th scope="col">@Localizer["Parent"]</th>
                    <th scope="col" style="width: 110px">@Localizer["Phone"]</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Children)
                {
                    <tr>
                        <td>
                            <span class="group-badge">@(item.ActivityGroupName ?? Localizer["Presence.None"].Value)</span>
                        </td>
                        <td>
                            <strong>@item.ChildFirstName @item.ChildLastName</strong>
                        </td>
                        <td>
                            @item.ChildBirthDate.ToString("dd/MM/yyyy")
                        </td>
                        <td>@item.ParentName</td>
                        <td>@item.ParentPhone</td>
                    </tr>
                }
            </tbody>
        </table>
    }

    <script>
        // Auto-print when page loads (optional)
        // window.onload = function() { window.print(); }
    </script>
</body>
</html>
