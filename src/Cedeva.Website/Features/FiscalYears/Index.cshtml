@model Cedeva.Website.Features.FiscalYears.FiscalYearSettingViewModel
@{
    ViewData["Title"] = Localizer["FiscalYear.Title"];
    var years = (ViewBag.Years as List<Cedeva.Core.Entities.FiscalYearSetting>) ?? new();
    var culture = new System.Globalization.CultureInfo("fr-BE");
}

@await Html.PartialAsync("_AlertMessages")

<h2><i class="fas fa-scale-balanced me-2"></i>@Localizer["FiscalYear.Title"]</h2>
<p class="text-muted">@Localizer["FiscalYear.Help"]</p>

<div class="row g-4">
    <div class="col-lg-7">
        <div class="card shadow">
            <div class="card-header bg-primary text-white">
                <h6 class="mb-0"><i class="fas fa-calendar me-2"></i>@Localizer["FiscalYear.Title"]</h6>
            </div>
            <div class="card-body p-0">
                <table class="table table-hover table-sm mb-0">
                    <thead class="table-light">
                        <tr>
                            <th scope="col">@Localizer["FiscalYear.Year"]</th>
                            <th scope="col" class="text-end">@Localizer["FiscalYear.MaxDailyAmount"]</th>
                            <th scope="col">@Localizer["FiscalYear.TaxCode"]</th>
                            <th scope="col"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var setting in years)
                        {
                            <tr>
                                <td>@setting.Year</td>
                                <td class="text-end">@setting.MaxDailyAmount.ToString("C", culture)</td>
                                <td>@setting.TaxCode</td>
                                <td class="text-end text-nowrap">
                                    <a asp-action="Edit" asp-route-id="@setting.Id" class="btn btn-sm btn-outline-secondary"><i class="fas fa-edit"></i></a>
                                    @await Html.PartialAsync("_DeleteButton", new DeleteButtonModel { Id = setting.Id, ConfirmMessage = Localizer["FiscalYear.ConfirmDelete", setting.Year].Value })
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="col-lg-5">
        <div class="card">
            <div class="card-header">
                <h6 class="mb-0"><i class="fas fa-plus me-2"></i>@Localizer["FiscalYear.Add"]</h6>
            </div>
            <div class="card-body">
                <form asp-action="Create" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                    @await Html.PartialAsync("_FiscalYearFields", Model)
                    <button type="submit" class="btn btn-primary"><i class="fas fa-save me-2"></i>@Localizer["Save"]</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
