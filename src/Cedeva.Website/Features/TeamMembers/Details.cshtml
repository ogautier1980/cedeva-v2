@using Cedeva.Core.Enums
@model Cedeva.Website.Features.TeamMembers.ViewModels.TeamMemberViewModel

@{
    ViewData["Title"] = Model.FullName;
    var culture = new System.Globalization.CultureInfo("fr-BE");
}

<div class="container-fluid py-4">
    @await Html.PartialAsync("_AlertMessages")

    <div class="row">
        <div class="col-12 member-sheet">
            <h2 class="text-primary fw-bold mb-4">@Localizer["Field.TeamMember"]</h2>

            <form asp-action="Details" asp-route-id="@Model.TeamMemberId" method="post" enctype="multipart/form-data">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                <input type="hidden" asp-for="TeamMemberId" />
                <input type="hidden" asp-for="AddressId" />
                <input type="hidden" asp-for="Country" />
                <input type="hidden" asp-for="LicenseUrl" />
                <input type="hidden" asp-for="CriminalRecordUrl" />

                <div class="input-group mb-2">
                    <span class="input-group-text fw-bold label-cell">@Localizer["LastName"]</span>
                    <input asp-for="LastName" class="form-control" />
                    <span asp-validation-for="LastName" class="invalid-feedback d-block"></span>
                </div>
                <div class="input-group mb-2">
                    <span class="input-group-text fw-bold label-cell">@Localizer["FirstName"]</span>
                    <input asp-for="FirstName" class="form-control" />
                    <span asp-validation-for="FirstName" class="invalid-feedback d-block"></span>
                </div>
                <div class="input-group mb-2">
                    <span class="input-group-text fw-bold label-cell">@Localizer["Field.BirthDate"]</span>
                    <input asp-for="BirthDate" type="date" class="form-control" />
                    <span asp-validation-for="BirthDate" class="invalid-feedback d-block"></span>
                </div>
                <div class="input-group mb-2">
                    <span class="input-group-text fw-bold label-cell">@Localizer["Field.NationalRegisterNumber"]</span>
                    <input asp-for="NationalRegisterNumber" class="form-control" placeholder="@Localizer["Children.NRNPlaceholder"]" />
                    <span asp-validation-for="NationalRegisterNumber" class="invalid-feedback d-block"></span>
                </div>
                <div class="input-group mb-2">
                    <span class="input-group-text fw-bold label-cell">@Localizer["Field.BankAccountNumber"]</span>
                    <input asp-for="BankAccountNumber" class="form-control" />
                    <span asp-validation-for="BankAccountNumber" class="invalid-feedback d-block"></span>
                </div>
                <div class="input-group mb-2">
                    <span class="input-group-text fw-bold label-cell">@Localizer["Field.Email"]</span>
                    <input asp-for="Email" type="email" class="form-control" />
                    <span asp-validation-for="Email" class="invalid-feedback d-block"></span>
                </div>
                <div class="input-group mb-2">
                    <span class="input-group-text fw-bold label-cell">@Localizer["Field.MobilePhoneNumber"]</span>
                    <input asp-for="MobilePhoneNumber" class="form-control" placeholder="@Localizer["Parents.MobilePlaceholder"]" />
                    <span asp-validation-for="MobilePhoneNumber" class="invalid-feedback d-block"></span>
                </div>
                <div class="input-group mb-2">
                    <span class="input-group-text fw-bold label-cell">@Localizer["Field.Street"]</span>
                    <input asp-for="Street" class="form-control" id="Street" placeholder="@Localizer["Parents.StreetPlaceholder"]" />
                    <span asp-validation-for="Street" class="invalid-feedback d-block"></span>
                </div>
                <div class="input-group mb-2">
                    <span class="input-group-text fw-bold label-cell">@Localizer["Field.PostalCodeCity"]</span>
                    <input type="text" class="form-control" id="CombinedAddress"
                           placeholder="@Localizer["Parents.PostalCodeCityPlaceholder"]"
                           value="@(string.IsNullOrEmpty(Model.PostalCode) ? "" : Model.PostalCode + " " + Model.City)" />
                    <input type="hidden" asp-for="PostalCode" id="PostalCode" />
                    <input type="hidden" asp-for="City" id="City" />
                </div>

                <h5 class="mt-4">@Localizer["Field.Role"]</h5>
                @foreach (var role in Enum.GetValues<TeamRole>())
                {
                    <div class="form-check">
                        <input class="form-check-input" type="radio" asp-for="TeamRole" value="@role" id="role_@role" />
                        <label class="form-check-label" for="role_@role">@Localizer[$"Enum.TeamRole.{role}"]</label>
                    </div>
                }

                <h5 class="mt-4">@Localizer["TeamMembers.Licenses"]</h5>
                @foreach (var license in Enum.GetValues<License>())
                {
                    <div class="form-check">
                        <input class="form-check-input" type="radio" asp-for="License" value="@license" id="license_@license" />
                        <label class="form-check-label" for="license_@license">
                            @Localizer[$"Enum.License.{license}"]
                            @switch (license)
                            {
                                case License.License:
                                case License.Assimilated:
                                    <i class="fas fa-check ms-1"></i>
                                    break;
                                case License.Internship:
                                    <i class="fas fa-user-graduate ms-1"></i>
                                    break;
                                default:
                                    <i class="fas fa-times ms-1"></i>
                                    break;
                            }
                        </label>
                    </div>
                }

                <h5 class="mt-4">@Localizer["Status"]</h5>
                @foreach (var status in Enum.GetValues<Status>())
                {
                    <div class="form-check">
                        <input class="form-check-input" type="radio" asp-for="Status" value="@status" id="status_@status" />
                        <label class="form-check-label" for="status_@status">@Localizer[$"Enum.Status.{status}"]</label>
                    </div>
                }

                <h5 class="mt-4">@Localizer["Field.LicenseFile"]</h5>
                @if (!string.IsNullOrEmpty(Model.LicenseUrl))
                {
                    <div class="mb-2" id="licensePreview">
                        <a asp-action="ViewLicense" asp-route-id="@Model.TeamMemberId" target="_blank" class="btn btn-sm btn-outline-primary">
                            <i class="fas fa-file-alt me-1"></i>@Localizer["TeamMembers.ViewLicense"]
                        </a>
                        <button type="button" class="btn btn-danger btn-sm" id="removeLicenseBtn" title="@Localizer["Field.RemoveLicense"]">
                            <i class="fas fa-times"></i>
                        </button>
                    </div>
                }
                <input asp-for="RemoveLicense" type="hidden" id="RemoveLicense" />
                <input asp-for="LicenseFile" type="file" class="form-control" accept="image/*,.pdf" />
                <span asp-validation-for="LicenseFile" class="text-danger"></span>

                <h5 class="mt-4">@Localizer["Field.CriminalRecordFile"]</h5>
                @if (!string.IsNullOrEmpty(Model.CriminalRecordUrl))
                {
                    <div class="mb-2" id="criminalRecordPreview">
                        <a asp-action="ViewCriminalRecord" asp-route-id="@Model.TeamMemberId" target="_blank" class="btn btn-sm btn-outline-primary">
                            <i class="fas fa-file-alt me-1"></i>@Localizer["TeamMembers.ViewCriminalRecord"]
                        </a>
                    </div>
                }
                <input asp-for="RemoveCriminalRecord" type="hidden" id="RemoveCriminalRecord" />
                <input asp-for="CriminalRecordFile" type="file" class="form-control" accept="image/*,.pdf" />
                <span asp-validation-for="CriminalRecordFile" class="text-danger"></span>

                <h5 class="mt-4">@Localizer["TeamMembers.Allowances"]</h5>
                <div class="input-group mb-2">
                    <span class="input-group-text fw-bold label-cell">@Localizer["Field.DailyCompensation"]</span>
                    <input asp-for="DailyCompensation" type="text" class="form-control"
                           data-val-number="@Localizer["Validation.Number"]" />
                    <span class="input-group-text">€</span>
                </div>
                <span asp-validation-for="DailyCompensation" class="text-danger"></span>

                @if (User.IsInRole("Admin") && ViewBag.Organisations != null)
                {
                    <h5 class="mt-4">@Localizer["Field.Organisation"]</h5>
                    <select asp-for="OrganisationId" class="form-select" asp-items="@ViewBag.Organisations" id="OrganisationId"></select>
                }
                else
                {
                    <input type="hidden" asp-for="OrganisationId" />
                }

                @* Extras and deductions belong to one activity, so they are shown per activity and
                   edited from that activity's accounts. *@
                @foreach (var compensation in Model.ActivityCompensations)
                {
                    <h5 class="mt-5">@compensation.ActivityName</h5>
                    <table class="table table-sm mb-2">
                        <thead>
                            <tr class="table-light">
                                <th scope="col">@Localizer["TeamMembers.ExtrasAndExpenses"]</th>
                                <th scope="col" class="text-end">@compensation.Total.ToString("C0", culture)</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td class="text-muted">@Localizer["TeamMembers.DailyAllowances"] (@compensation.DaysWorked)</td>
                                <td class="text-end text-muted">@compensation.DailyAllowances.ToString("C0", culture)</td>
                            </tr>
                            @foreach (var line in compensation.Lines)
                            {
                                <tr>
                                    <td class="text-muted">@line.Label</td>
                                    <td class="text-end text-muted">@line.Amount.ToString("C0", culture)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    <a asp-controller="Financial" asp-action="CreateExpense"
                       asp-route-id="@compensation.ActivityId" asp-route-teamMemberId="@Model.TeamMemberId"
                       asp-route-returnUrl="@Url.Action("Details", "TeamMembers", new { id = Model.TeamMemberId })"
                       class="btn btn-sm btn-outline-secondary">
                        <i class="fas fa-plus-circle me-2"></i>@Localizer["TeamMembers.AddExtraOrExpense"]
                    </a>
                }

                @if (!Model.ActivityCompensations.Any())
                {
                    <p class="text-muted mt-5">@Localizer["TeamMembers.NoOngoingActivity"]</p>
                }

                <hr class="my-4" />

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-save me-2"></i>@Localizer["Save"]
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary">
                        <i class="fas fa-arrow-left me-2"></i>@Localizer["BackToList"]
                    </a>
                </div>
            </form>

            <div class="mt-4 pt-3 border-top">
                <small class="text-muted" style="font-weight: 300;">
                    @Localizer["Audit.CreatedBy"] <strong>@Model.CreatedByDisplayName</strong>
                    @Localizer["Audit.On"] @Model.CreatedAt.ToString("dd/MM/yyyy")

                    @if (Model.ModifiedAt.HasValue)
                    {
                        <br />
                        @Localizer["Audit.ModifiedBy"] <strong>@(Model.ModifiedByDisplayName ?? "System")</strong>
                        @Localizer["Audit.On"] @Model.ModifiedAt.Value.ToString("dd/MM/yyyy")
                    }
                </small>
            </div>
        </div>
    </div>
</div>

<style>
    /* A member sheet is a column of short fields: full-width inputs would be unreadable. */
    .member-sheet {
        max-width: 46rem;
    }

    /* The grey label cell of the identity rows, kept at a constant width. */
    .label-cell {
        width: 13rem;
        white-space: normal;
        text-align: left;
    }
</style>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/belgian-municipality-validator.js"></script>
    <script src="~/js/unified-address-autocomplete.js"></script>

    <script>
        $(function () {
            CedevaChoices.init('#OrganisationId');
            initializeUnifiedAddressAutocomplete("#CombinedAddress", "#PostalCode", "#City");

            $('#removeLicenseBtn').on('click', function () {
                if (confirm(@Json.Serialize(Localizer["TeamMembers.ConfirmDeleteLicense"].Value))) {
                    $('#RemoveLicense').val('true');
                    $('#licensePreview').hide();
                }
            });
        });
    </script>
}
