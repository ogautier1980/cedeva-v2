@inject Cedeva.Core.Interfaces.ICurrentUserService CurrentUserService
@inject Cedeva.Infrastructure.Data.CedevaDbContext DbContext
@using Microsoft.EntityFrameworkCore

@{
    // ActivityManagement navigation variables
    int activityId = ViewData.ContainsKey("ActivityId") ? Convert.ToInt32(ViewData["ActivityId"]) : 0;
    string navSection = ViewData.ContainsKey("NavSection") ? ViewData["NavSection"]?.ToString() ?? "" : "";
    string activityName = ViewData.ContainsKey("ActivityName") ? ViewData["ActivityName"]?.ToString() ?? "" : "";
}

<!DOCTYPE html>
<html lang="fr" class="h-100">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />
    <title>@ViewData["Title"] - Cedeva</title>

    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <!-- Font Awesome -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet" />
    <!-- jQuery UI CSS -->
    <link href="https://code.jquery.com/ui/1.13.2/themes/base/jquery-ui.min.css" rel="stylesheet" />
    <!-- Choices.js CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/choices.js@10.2.0/public/assets/styles/choices.min.css" />
    <!-- Custom styles -->
    <link rel="stylesheet" href="~/css/cedeva.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)

    <style>
        /* Activity Management Compact Navigation */
        .activity-nav-compact .nav-link {
            font-size: 0.875rem;
            padding: 0.5rem 0.75rem;
            white-space: nowrap;
        }

        .activity-nav-compact .nav-link i {
            font-size: 0.875rem;
        }

        /* Hide text on smaller screens, keep only icons */
        @@media (max-width: 1400px) {
            .activity-nav-compact .nav-link {
                padding: 0.5rem;
            }
        }
    </style>
</head>
<body class="d-flex flex-column h-100 bg-img">
    @{
        var brandName = "Cedeva";
        if (User.IsInRole("Coordinator") && CurrentUserService.OrganisationId.HasValue)
        {
            var organisation = await DbContext.Organisations
                .Where(o => o.Id == CurrentUserService.OrganisationId.Value)
                .Select(o => o.Name)
                .FirstOrDefaultAsync();
            if (!string.IsNullOrEmpty(organisation))
            {
                brandName = organisation;
            }
        }
    }
    <div id="wrapper">
        <!-- Page Content -->
        <div id="page-content-wrapper" class="w-100">
            <!-- Top Navigation -->
            <nav class="navbar navbar-expand-lg navbar-dark bg-primary border-bottom" style="position: relative; z-index: 1030;">
                <div class="container-fluid">
                    <a href="/" class="navbar-brand text-white fw-bold">
                        <i class="fas fa-campground me-2"></i>@brandName
                    </a>

                    @if (activityId > 0)
                    {
                        <!-- Activity Management Navigation -->
                        <div class="d-flex align-items-center text-white me-2">
                            <a asp-action="Index" asp-controller="ActivityManagement" asp-route-id="@activityId"
                               class="btn btn-sm btn-outline-light me-2" title="@Localizer["BackToDashboard"]">
                                <i class="fas fa-arrow-left"></i>
                            </a>
                            <span class="text-white-50 me-2 d-none d-xl-inline small">@activityName</span>
                        </div>

                        <ul class="navbar-nav me-auto activity-nav-compact">
                            <!-- Tableau de bord (retour aux 7 gros boutons) -->
                            <li class="nav-item">
                                <a class="nav-link @(navSection == "" || navSection == null ? "active" : "")"
                                   asp-action="Index" asp-controller="ActivityManagement" asp-route-id="@activityId">
                                    <i class="fas fa-th-large"></i> @Localizer["Home.Dashboard"]
                                </a>
                            </li>

                            <!-- Pages spéciales (dropdown) -->
                            <li class="nav-item dropdown">
                                <button class="nav-link dropdown-toggle @((navSection == "Groups" || navSection == "PresenceSummary" || navSection == "TeamPresences") ? "active" : "") btn btn-link"
                                        type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="fas fa-layer-group"></i> @Localizer["ActivityManagement.SpecialPages"]
                                </button>
                                <ul class="dropdown-menu">
                                    <li>
                                        <a class="dropdown-item @(navSection == "Groups" ? "active" : "")"
                                           asp-action="Groups" asp-controller="ActivityManagement" asp-route-id="@activityId">
                                            <i class="fas fa-layer-group"></i> @Localizer["ActivityManagement.GroupsList"]
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item @(navSection == "PresenceSummary" ? "active" : "")"
                                           asp-action="PresenceSummary" asp-controller="ActivityManagement" asp-route-id="@activityId">
                                            <i class="fas fa-chart-bar"></i> @Localizer["ActivityManagement.PresenceSummary"]
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item @(navSection == "TeamPresences" ? "active" : "")"
                                           asp-action="TeamPresences" asp-controller="ActivityManagement" asp-route-id="@activityId">
                                            <i class="fas fa-user-check"></i> @Localizer["ActivityManagement.TeamPresences"]
                                        </a>
                                    </li>
                                </ul>
                            </li>
                        </ul>
                    }

                    <div class="collapse navbar-collapse">
                        <ul class="navbar-nav ms-auto">
                            @{
                                var currentCulture = System.Globalization.CultureInfo.CurrentUICulture.Name;
                                var languageCode = currentCulture.StartsWith("fr") ? "fr" :
                                                   currentCulture.StartsWith("nl") ? "nl" :
                                                   currentCulture.StartsWith("en") ? "en" : "";
                                var languageIcon = languageCode switch
                                {
                                    "fr" => "🇫🇷",
                                    "nl" => "🇳🇱",
                                    "en" => "🇬🇧",
                                    _ => "🌐"
                                };
                                var languageName = languageCode switch
                                {
                                    "fr" => "Français",
                                    "nl" => "Nederlands",
                                    "en" => "English",
                                    _ => "Language"
                                };
                            }
                            <li class="nav-item dropdown">
                                <button class="nav-link dropdown-toggle btn btn-link text-white text-decoration-none" id="languageDropdown" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <span class="me-1">@languageIcon</span>@languageName
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    <li>
                                        <form asp-controller="Home" asp-action="SetLanguage" method="post" class="dropdown-item p-0">
                                            <input type="hidden" name="culture" value="fr" />
                                            <input type="hidden" name="returnUrl" value="@Context.Request.Path" />
                                            <button type="submit" class="btn btn-link text-decoration-none text-dark w-100 text-start">
                                                🇫🇷 Français
                                            </button>
                                        </form>
                                    </li>
                                    <li>
                                        <form asp-controller="Home" asp-action="SetLanguage" method="post" class="dropdown-item p-0">
                                            <input type="hidden" name="culture" value="nl" />
                                            <input type="hidden" name="returnUrl" value="@Context.Request.Path" />
                                            <button type="submit" class="btn btn-link text-decoration-none text-dark w-100 text-start">
                                                🇳🇱 Nederlands
                                            </button>
                                        </form>
                                    </li>
                                    <li>
                                        <form asp-controller="Home" asp-action="SetLanguage" method="post" class="dropdown-item p-0">
                                            <input type="hidden" name="culture" value="en" />
                                            <input type="hidden" name="returnUrl" value="@Context.Request.Path" />
                                            <button type="submit" class="btn btn-link text-decoration-none text-dark w-100 text-start">
                                                🇬🇧 English
                                            </button>
                                        </form>
                                    </li>
                                </ul>
                            </li>
                            @if (User.Identity?.IsAuthenticated == true)
                            {
                                <li class="nav-item dropdown">
                                    <button class="nav-link dropdown-toggle btn btn-link text-white text-decoration-none" id="navbarDropdown" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                        <i class="fas fa-user-circle me-1"></i>@User.Identity.Name
                                    </button>
                                    <ul class="dropdown-menu dropdown-menu-end">
                                        <li><a class="dropdown-item" href="/Account/Profile">@Localizer["Layout.Profile"]</a></li>
                                        <li><hr class="dropdown-divider"></li>
                                        <li>
                                            <form asp-controller="Account" asp-action="Logout" method="post">
                                                <button type="submit" class="dropdown-item">@Localizer["Layout.Logout"]</button>
                                            </form>
                                        </li>
                                    </ul>
                                </li>
                            }
                        </ul>
                    </div>
                </div>
            </nav>

            <!-- Main Content -->
            <main class="flex-shrink-0 p-4">
                <div class="container-fluid">
                    @RenderBody()
                </div>
            </main>

            <!-- Footer -->
            <footer class="footer mt-auto py-3 bg-dark">
                <div class="container">
                    <span class="text-center txt-footer d-block">
                        <small>&copy; @DateTime.Now.Year - Cedeva - <a class="text-reset" href="/Home/Privacy">@Localizer["Layout.Privacy"]</a></small>
                    </span>
                </div>
            </footer>
        </div>
    </div>

    <!-- jQuery -->
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <!-- jQuery UI -->
    <script src="https://code.jquery.com/ui/1.13.2/jquery-ui.min.js"></script>
    <!-- Bootstrap 5 JS Bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <!-- Choices.js -->
    <script src="https://cdn.jsdelivr.net/npm/choices.js@10.2.0/public/assets/scripts/choices.min.js"></script>
    <!-- Cedeva Choices Helper -->
    <script src="~/js/choices-helper.js"></script>

    <script>
        // Enable Bootstrap tooltips everywhere (used by the "informations" help icons).
        document.querySelectorAll('[data-bs-toggle="tooltip"]').forEach(function (el) {
            new bootstrap.Tooltip(el);
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
