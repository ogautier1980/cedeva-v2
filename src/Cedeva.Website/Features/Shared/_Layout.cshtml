@inject Cedeva.Core.Interfaces.ICurrentUserService CurrentUserService
@inject Cedeva.Infrastructure.Data.CedevaDbContext DbContext
@using Microsoft.EntityFrameworkCore

@{
    // ActivityManagement navigation variables
    int activityId = ViewData.ContainsKey("ActivityId") ? Convert.ToInt32(ViewData["ActivityId"]) : 0;
    string navSection = ViewData.ContainsKey("NavSection") ? ViewData["NavSection"]?.ToString() ?? "" : "";
    string navAction = ViewData.ContainsKey("NavAction") ? ViewData["NavAction"]?.ToString() ?? "" : "";

    // The activity menu follows the section being worked in: the pages that help there, not every
    // page of the activity. Booking management only deals with registrations, so it gets no extra
    // entry; presence screens use the default set.
    string navFamily = navSection switch
    {
        "ManageBookings" => "bookings",
        "Financial" => "financial",
        "Emails" => "emails",
        "Team" or "TeamPresences" => "team",
        "Excursions" => "excursions",
        "ActivitySettings" or "ActivityGroups" or "ActivityQuestions" or "EmbedCode" => "settings",
        _ => "presences"
    };

    List<Cedeva.Core.Entities.ActivityGroup> activityGroups = new();
    int? todayActivityDayId = null;
    if (activityId > 0)
    {
        activityGroups = await DbContext.ActivityGroups
            .Where(g => g.ActivityId == activityId)
            .OrderBy(g => g.Label)
            .ToListAsync();
        todayActivityDayId = await DbContext.ActivityDays
            .Where(d => d.ActivityId == activityId && d.IsActive && d.DayDate.Date == DateTime.Today)
            .Select(d => (int?)d.DayId)
            .FirstOrDefaultAsync();
    }

    string? printAllGroupsTodayUrl = null;
    if (activityId > 0)
    {
        printAllGroupsTodayUrl = Url.Action("PrintGroups", "ActivityManagement", new { activityId, dayId = todayActivityDayId })
            + string.Concat(activityGroups.Select(g => $"&groupIds={g.Id}"));
    }
}

<!DOCTYPE html>
<html lang="fr" class="h-100">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />
    <title>@ViewData["Title"] - Cedeva</title>

    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <!-- Font Awesome -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet" />
    <!-- jQuery UI CSS -->
    <link href="https://code.jquery.com/ui/1.13.2/themes/base/jquery-ui.min.css" rel="stylesheet" />
    <!-- Choices.js CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/choices.js@10.2.0/public/assets/styles/choices.min.css" />
    <!-- Custom styles -->
    <link rel="stylesheet" href="~/css/cedeva.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)

    <style>
        /* Activity Management Compact Navigation */
        .activity-nav-compact .nav-link {
            font-size: 0.875rem;
            padding: 0.5rem 0.75rem;
            white-space: nowrap;
        }

        .activity-nav-compact .nav-link i {
            font-size: 0.875rem;
        }

        /* Hide text on smaller screens, keep only icons */
        @@media (max-width: 1400px) {
            .activity-nav-compact .nav-link {
                padding: 0.5rem;
            }
        }
    </style>
</head>
<body class="d-flex flex-column h-100 bg-img">
    @{
        var brandName = "Cedeva";
        if (User.IsInRole("Coordinator") && CurrentUserService.OrganisationId.HasValue)
        {
            var organisation = await DbContext.Organisations
                .Where(o => o.Id == CurrentUserService.OrganisationId.Value)
                .Select(o => o.Name)
                .FirstOrDefaultAsync();
            if (!string.IsNullOrEmpty(organisation))
            {
                brandName = organisation;
            }
        }
    }
    <div id="wrapper">
        <!-- Page Content -->
        <div id="page-content-wrapper" class="w-100">
            <!-- Top Navigation -->
            <nav class="navbar navbar-expand-lg navbar-dark bg-primary border-bottom" style="position: relative; z-index: 1030;">
                <div class="container-fluid">
                    <a href="/" class="navbar-brand text-white fw-bold">
                        <i class="fas fa-campground me-2"></i>@brandName
                    </a>

                    @if (activityId > 0)
                    {
                        <ul class="navbar-nav me-auto activity-nav-compact">
                            <!-- Tableau de bord (retour aux 7 gros boutons) -->
                            <li class="nav-item">
                                <a class="nav-link @(navSection == "" || navSection == null ? "active" : "")"
                                   asp-action="Index" asp-controller="ActivityManagement" asp-route-id="@activityId">
                                    <i class="fas fa-th-large"></i> @Localizer["Home.Dashboard"]
                                </a>
                            </li>

                            @if (navFamily == "financial")
                            {
                                <li class="nav-item">
                                    <a class="nav-link @(navAction == "Transactions" ? "active" : "")"
                                       asp-action="Transactions" asp-controller="Financial">
                                        <i class="fas fa-exchange-alt"></i> @Localizer["Financial.Transactions"]
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link @(navAction == "Balance" ? "active" : "")"
                                       asp-action="Balance" asp-controller="Financial">
                                        <i class="fas fa-scale-balanced"></i> @Localizer["Financial.Balance.Title"]
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-action="Index" asp-controller="ExpenseCategories">
                                        <i class="fas fa-tags"></i> @Localizer["Financial.Categories"]
                                    </a>
                                </li>
                            }
                            else if (navFamily == "emails")
                            {
                                <li class="nav-item">
                                    <a class="nav-link @(navAction == "SendEmail" ? "active" : "")"
                                       asp-action="SendEmail" asp-controller="ActivityManagement" asp-route-id="@activityId">
                                        <i class="fas fa-paper-plane"></i> @Localizer["ActivityManagement.Emails"]
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-action="Index" asp-controller="EmailTemplates" asp-route-activityId="@activityId">
                                        <i class="fas fa-file-alt"></i> @Localizer["ActivityManagement.EmailTemplates"]
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link @(navAction == "SentEmails" ? "active" : "")"
                                       asp-action="SentEmails" asp-controller="ActivityManagement" asp-route-id="@activityId">
                                        <i class="fas fa-inbox"></i> @Localizer["Email.History"]
                                    </a>
                                </li>
                            }
                            else if (navFamily == "team")
                            {
                                <li class="nav-item">
                                    <a class="nav-link @(navSection == "Team" && navAction != "Payout" && navAction != "TeamSalaries" ? "active" : "")"
                                       asp-action="TeamMembers" asp-controller="ActivityManagement" asp-route-id="@activityId">
                                        <i class="fas fa-users"></i> @Localizer["ActivityManagement.Team"]
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link @(navSection == "TeamPresences" ? "active" : "")"
                                       asp-action="TeamPresences" asp-controller="ActivityManagement" asp-route-id="@activityId">
                                        <i class="fas fa-user-check"></i> @Localizer["ActivityManagement.TeamPresences"]
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link @(navAction == "TeamSalaries" ? "active" : "")"
                                       asp-action="TeamSalaries" asp-controller="Financial">
                                        <i class="fas fa-euro-sign"></i> @Localizer["Financial.TeamSalaries"]
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link @(navAction == "Payout" ? "active" : "")"
                                       asp-action="Payout" asp-controller="Financial" asp-route-id="@activityId">
                                        <i class="fas fa-money-check"></i> @Localizer["Financial.Payout"]
                                    </a>
                                </li>
                            }
                            else if (navFamily == "bookings")
                            {
                                // Registrations only: the dashboard link above is enough.
                            }
                            else if (navFamily == "excursions")
                            {
                                <li class="nav-item">
                                    <a class="nav-link @(navAction == "Index" ? "active" : "")"
                                       asp-action="Index" asp-controller="Excursions" asp-route-id="@activityId">
                                        <i class="fas fa-bus"></i> @Localizer["ActivityManagement.Excursions"]
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-action="Create" asp-controller="Excursions" asp-route-id="@activityId">
                                        <i class="fas fa-plus-circle"></i> @Localizer["Excursion.CreateNew"]
                                    </a>
                                </li>
                            }
                            else if (navFamily == "settings")
                            {
                                <li class="nav-item">
                                    <a class="nav-link @(navSection == "ActivitySettings" ? "active" : "")"
                                       asp-action="Edit" asp-controller="Activities" asp-route-id="@activityId">
                                        <i class="fas fa-cog"></i> @Localizer["ActivityManagement.Settings"]
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link @(navSection == "ActivityGroups" ? "active" : "")"
                                       asp-action="Index" asp-controller="ActivityGroups" asp-route-activityId="@activityId">
                                        <i class="fas fa-layer-group"></i> @Localizer["ActivityGroups.Title"]
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link @(navSection == "ActivityQuestions" ? "active" : "")"
                                       asp-action="Index" asp-controller="ActivityQuestions" asp-route-activityId="@activityId">
                                        <i class="fas fa-question-circle"></i> @Localizer["ActivityQuestions.Title"]
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link @(navSection == "EmbedCode" ? "active" : "")"
                                       asp-action="EmbedCode" asp-controller="PublicRegistration" asp-route-id="@activityId">
                                        <i class="fas fa-code"></i> @Localizer["PublicRegistration.IntegrationCode"]
                                    </a>
                                </li>
                            }
                            else
                            {
                            <!-- Groupes (dropdown) -->
                            <li class="nav-item dropdown">
                                <button class="nav-link dropdown-toggle @(navSection == "Groups" ? "active" : "") btn btn-link"
                                        type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="fas fa-layer-group"></i> @Localizer["ActivityManagement.GroupsNav"]
                                </button>
                                <ul class="dropdown-menu">
                                    @foreach (var group in activityGroups)
                                    {
                                        <li>
                                            <a class="dropdown-item" asp-action="Groups" asp-controller="ActivityManagement"
                                               asp-route-id="@activityId" asp-route-groupIds="@group.Id">
                                                <i class="fas fa-layer-group"></i> @group.Label
                                            </a>
                                        </li>
                                    }
                                    @if (activityGroups.Count > 0)
                                    {
                                        <li><hr class="dropdown-divider" /></li>
                                    }
                                    <li>
                                        <a class="dropdown-item @(navSection == "Groups" ? "active" : "")"
                                           asp-action="Groups" asp-controller="ActivityManagement" asp-route-id="@activityId">
                                            <i class="fas fa-list"></i> @Localizer["ActivityManagement.DynamicLists"]
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" href="@printAllGroupsTodayUrl" target="_blank">
                                            <i class="fas fa-calendar-day"></i> @Localizer["ActivityManagement.PrintAllGroupsToday"]
                                        </a>
                                    </li>
                                </ul>
                            </li>

                            <!-- Total des présences -->
                            <li class="nav-item">
                                <a class="nav-link @(navSection == "PresenceSummary" ? "active" : "")"
                                   asp-action="PresenceSummary" asp-controller="ActivityManagement" asp-route-id="@activityId">
                                    <i class="fas fa-chart-bar"></i> @Localizer["ActivityManagement.PresenceSummary"]
                                </a>
                            </li>

                            <!-- Garderie -->
                            <li class="nav-item">
                                <a class="nav-link @(navSection == "Childcare" ? "active" : "")"
                                   asp-action="Childcare" asp-controller="ActivityManagement" asp-route-id="@activityId">
                                    <i class="fas fa-child"></i> @Localizer["ActivityManagement.Childcare"]
                                </a>
                            </li>
                            }
                        </ul>
                    }

                    <div class="collapse navbar-collapse">
                        <ul class="navbar-nav ms-auto">
                            @{
                                var currentCulture = System.Globalization.CultureInfo.CurrentUICulture.Name;
                                var languageCode = currentCulture.StartsWith("fr") ? "fr" :
                                                   currentCulture.StartsWith("nl") ? "nl" :
                                                   currentCulture.StartsWith("en") ? "en" : "";
                                var languageIcon = languageCode switch
                                {
                                    "fr" => "🇫🇷",
                                    "nl" => "🇳🇱",
                                    "en" => "🇬🇧",
                                    _ => "🌐"
                                };
                                var languageName = languageCode switch
                                {
                                    "fr" => "Français",
                                    "nl" => "Nederlands",
                                    "en" => "English",
                                    _ => "Language"
                                };
                            }
                            <li class="nav-item dropdown">
                                <button class="nav-link dropdown-toggle btn btn-link text-white text-decoration-none" id="languageDropdown" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <span class="me-1">@languageIcon</span>@languageName
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    <li>
                                        <form asp-controller="Home" asp-action="SetLanguage" method="post" class="dropdown-item p-0">
                                            <input type="hidden" name="culture" value="fr" />
                                            <input type="hidden" name="returnUrl" value="@Context.Request.Path" />
                                            <button type="submit" class="btn btn-link text-decoration-none text-dark w-100 text-start">
                                                🇫🇷 Français
                                            </button>
                                        </form>
                                    </li>
                                    <li>
                                        <form asp-controller="Home" asp-action="SetLanguage" method="post" class="dropdown-item p-0">
                                            <input type="hidden" name="culture" value="nl" />
                                            <input type="hidden" name="returnUrl" value="@Context.Request.Path" />
                                            <button type="submit" class="btn btn-link text-decoration-none text-dark w-100 text-start">
                                                🇳🇱 Nederlands
                                            </button>
                                        </form>
                                    </li>
                                    <li>
                                        <form asp-controller="Home" asp-action="SetLanguage" method="post" class="dropdown-item p-0">
                                            <input type="hidden" name="culture" value="en" />
                                            <input type="hidden" name="returnUrl" value="@Context.Request.Path" />
                                            <button type="submit" class="btn btn-link text-decoration-none text-dark w-100 text-start">
                                                🇬🇧 English
                                            </button>
                                        </form>
                                    </li>
                                </ul>
                            </li>
                            @if (User.Identity?.IsAuthenticated == true)
                            {
                                <li class="nav-item dropdown">
                                    <button class="nav-link dropdown-toggle btn btn-link text-white text-decoration-none" id="navbarDropdown" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                        <i class="fas fa-user-circle me-1"></i>@User.Identity.Name
                                    </button>
                                    <ul class="dropdown-menu dropdown-menu-end">
                                        <li><a class="dropdown-item" href="/Account/Profile">@Localizer["Layout.Profile"]</a></li>
                                        <li><hr class="dropdown-divider"></li>
                                        <li>
                                            <form asp-controller="Account" asp-action="Logout" method="post">
                                                <button type="submit" class="dropdown-item">@Localizer["Layout.Logout"]</button>
                                            </form>
                                        </li>
                                    </ul>
                                </li>
                            }
                        </ul>
                    </div>
                </div>
            </nav>

            <!-- Main Content -->
            <main class="flex-shrink-0 p-4">
                <div class="container-fluid">
                    @RenderBody()
                </div>
            </main>

            <!-- Footer -->
            <footer class="footer mt-auto py-3 bg-dark">
                <div class="container">
                    <span class="text-center txt-footer d-block">
                        <small>&copy; @DateTime.Now.Year - Cedeva - <a class="text-reset" href="/Home/Privacy">@Localizer["Layout.Privacy"]</a></small>
                    </span>
                </div>
            </footer>
        </div>
    </div>

    <!-- jQuery -->
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <!-- jQuery UI -->
    <script src="https://code.jquery.com/ui/1.13.2/jquery-ui.min.js"></script>
    <!-- Bootstrap 5 JS Bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <!-- Choices.js -->
    <script src="https://cdn.jsdelivr.net/npm/choices.js@10.2.0/public/assets/scripts/choices.min.js"></script>
    <!-- Cedeva Choices Helper -->
    <script src="~/js/choices-helper.js"></script>
    <!-- Clickable table rows (lists) -->
    <script src="~/js/clickable-rows.js" asp-append-version="true"></script>

    <script>
        // Enable Bootstrap tooltips everywhere (used by the "informations" help icons).
        document.querySelectorAll('[data-bs-toggle="tooltip"]').forEach(function (el) {
            new bootstrap.Tooltip(el);
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
