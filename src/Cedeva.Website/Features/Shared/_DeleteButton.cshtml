@model Cedeva.Website.Features.Shared.ViewModels.DeleteButtonModel
@* Inline delete form with a JS confirm. Antiforgery token is added by the tag-helper form. *@
@* Without an explicit controller, post to the current page's controller: an empty asp-controller
   otherwise resolved to /Home/Delete (404) on every page using this partial. *@
<form asp-action="@Model.Action" asp-controller="@(Model.Controller ?? ViewContext.RouteData.Values["controller"]?.ToString())" asp-route-id="@Model.Id" method="post"
      class="d-inline" onsubmit="return confirm('@Model.ConfirmMessage');">
    <button type="submit" class="btn @(Model.Small ? "btn-sm " : "")btn-outline-danger" title="@Model.ConfirmMessage">
        <i class="fas fa-trash"></i>
    </button>
</form>
