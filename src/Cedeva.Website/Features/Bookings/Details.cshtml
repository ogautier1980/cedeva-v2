@model Cedeva.Website.Features.Bookings.ViewModels.BookingViewModel
@using Cedeva.Core.Enums
@{
    ViewData["Title"] = Localizer["Bookings.Details"];
}

<div class="container-fluid">
    @await Html.PartialAsync("_AlertMessages")
    <div class="row">
        <div class="col-lg-8">
            <div class="card shadow">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5 class="mb-0"><i class="fas fa-clipboard-list me-2"></i>@Localizer["Bookings.BookingDetails"]</h5>
                    <div class="d-flex gap-2">
                        <a asp-action="MutualityAttestation" asp-route-id="@Model.Id" target="_blank" class="btn btn-sm btn-outline-secondary text-nowrap">
                            <i class="fas fa-file-medical me-1"></i>@Localizer["Bookings.MutualityAttestation"]
                        </a>
                        <a asp-action="Edit" asp-route-id="@Model.Id" asp-route-returnUrl="@Url.Action("Details", new { id = Model.Id })" class="btn btn-sm btn-primary text-nowrap">
                            <i class="fas fa-edit me-1"></i>@Localizer["Edit"]
                        </a>
                        <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-sm btn-danger text-nowrap">
                            <i class="fas fa-trash me-1"></i>@Localizer["Delete"]
                        </a>
                    </div>
                </div>
                <div class="card-body">
                    <h3 class="mb-1">
                        <a asp-controller="Children" asp-action="Details" asp-route-id="@Model.ChildId" class="text-decoration-none">
                            @Model.ChildFullName
                        </a>
                        <a asp-controller="Children" asp-action="Edit" asp-route-id="@Model.ChildId"
                           asp-route-returnUrl="@Url.Action("Details", "Bookings", new { id = Model.Id })"
                           class="text-decoration-none ms-1" style="font-size: 1rem;"
                           title="@Localizer["Bookings.EditChildInfo"]">
                            <i class="fas fa-pencil-alt"></i>
                        </a>
                    </h3>
                    @if (Model.ChildBirthDate.HasValue)
                    {
                        <p class="text-muted mb-4">
                            <i class="fas fa-birthday-cake me-1"></i>@Model.ChildBirthDate.Value.ToString("dd/MM/yyyy")
                        </p>
                    }

                    <h6 class="mb-3 text-primary">
                        <i class="fas fa-calendar-week me-2"></i>
                        <a asp-controller="Activities" asp-action="Details" asp-route-id="@Model.ActivityId" class="text-decoration-none">@Model.ActivityName</a>
                        <small class="text-muted ms-2">
                            @Model.ActivityStartDate?.ToString("dd/MM/yyyy") - @Model.ActivityEndDate?.ToString("dd/MM/yyyy")
                        </small>
                    </h6>

                    @if (!Model.IsConfirmed)
                    {
                        <form asp-action="Edit" asp-route-id="@Model.Id" asp-route-returnUrl="@Url.Action("Details", new { id = Model.Id })" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="BookingDate" value="@Model.BookingDate.ToString("yyyy-MM-dd")" />
                            <input type="hidden" name="ChildId" value="@Model.ChildId" />
                            <input type="hidden" name="ActivityId" value="@Model.ActivityId" />
                            <input type="hidden" name="GroupId" value="@Model.GroupId" />
                            <input type="hidden" name="IsMedicalSheet" value="@Model.IsMedicalSheet.ToString().ToLowerInvariant()" />

                            @if (Model.AllActivityDays.Any())
                            {
                                <div class="row g-3 mb-3">
                                    @foreach (var week in Model.AllActivityDays)
                                    {
                                        <div class="col-md-6 col-lg-4">
                                            <div class="card h-100">
                                                <div class="card-header bg-light">
                                                    <i class="fas fa-calendar me-2"></i>@week.WeekLabel
                                                    <small class="text-muted ms-2">(@week.StartDate.ToString("dd/MM") - @week.EndDate.ToString("dd/MM/yyyy"))</small>
                                                </div>
                                                <div class="card-body p-0">
                                                    <div class="list-group list-group-flush">
                                                        @foreach (var day in week.Days)
                                                        {
                                                            var dayName = day.DayOfWeek switch
                                                            {
                                                                DayOfWeek.Monday => Localizer["DayOfWeek.Monday"],
                                                                DayOfWeek.Tuesday => Localizer["DayOfWeek.Tuesday"],
                                                                DayOfWeek.Wednesday => Localizer["DayOfWeek.Wednesday"],
                                                                DayOfWeek.Thursday => Localizer["DayOfWeek.Thursday"],
                                                                DayOfWeek.Friday => Localizer["DayOfWeek.Friday"],
                                                                DayOfWeek.Saturday => Localizer["DayOfWeek.Saturday"],
                                                                DayOfWeek.Sunday => Localizer["DayOfWeek.Sunday"],
                                                                _ => ""
                                                            };
                                                            var isWeekend = day.DayOfWeek == DayOfWeek.Saturday || day.DayOfWeek == DayOfWeek.Sunday;
                                                            var bgClass = isWeekend ? "bg-light" : "";

                                                            <div class="list-group-item @bgClass py-2">
                                                                <div class="form-check">
                                                                    <input class="form-check-input" type="checkbox"
                                                                           name="SelectedActivityDayIds" value="@day.ActivityDayId"
                                                                           id="day_@day.ActivityDayId" @(day.IsReserved ? "checked" : "") />
                                                                    <label class="form-check-label" for="day_@day.ActivityDayId">
                                                                        <strong>@dayName</strong>
                                                                        <small class="text-muted ms-1">@day.Date.ToString("dd/MM")</small>
                                                                        @if (isWeekend)
                                                                        {
                                                                            <span class="badge bg-warning text-dark ms-1" style="font-size: 0.65rem;">Week-end</span>
                                                                        }
                                                                    </label>
                                                                </div>
                                                            </div>
                                                        }
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                            else
                            {
                                <div class="alert alert-info">
                                    <i class="fas fa-info-circle me-2"></i>@Localizer["Bookings.NoDaysReserved"]
                                </div>
                            }

                            <div class="mb-3">
                                <label for="TotalAmount" class="form-label">@Localizer["Bookings.ExpectedTotalToPay"]</label>
                                <div class="input-group" style="max-width: 200px;">
                                    <input type="number" step="0.01" min="0" class="form-control" id="TotalAmount" name="TotalAmount"
                                           value="@Model.TotalAmount.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)" />
                                    <span class="input-group-text">€</span>
                                </div>
                            </div>

                            @* No "not fully paid" confirmation prompt: confirming is precisely what
                               sends the parent the payment link, so an unpaid balance is expected. *@
                            <div class="d-flex gap-2 mb-2">
                                <button type="submit" name="IsConfirmed" value="true" class="btn btn-success">
                                    <i class="fas fa-check me-2"></i>@Localizer["Bookings.ConfirmBooking"]
                                </button>
                                <button type="submit" class="btn btn-outline-danger"
                                        formaction="@Url.Action("Delete", new { id = Model.Id })" formmethod="post" formnovalidate>
                                    <i class="fas fa-trash me-2"></i>@Localizer["Bookings.DeleteBooking"]
                                </button>
                            </div>
                        </form>
                    }

                    <hr />

                    <h6 class="mb-3 text-primary"><i class="fas fa-user-shield me-2"></i>@Localizer["Bookings.LegalGuardian"]</h6>

                    <dl class="row">
                        <dt class="col-sm-4">@Localizer["Parent"]</dt>
                        <dd class="col-sm-8">
                            <i class="fas fa-user me-1"></i>@Model.ParentFullName
                            @if (!string.IsNullOrEmpty(Model.ParentEmail))
                            {
                                <br /><small class="text-muted"><i class="fas fa-envelope me-1"></i>@Model.ParentEmail</small>
                            }
                            @if (!string.IsNullOrEmpty(Model.ParentPhone))
                            {
                                <br /><small class="text-muted"><i class="fas fa-phone me-1"></i>@Model.ParentPhone</small>
                            }
                            @if (!string.IsNullOrEmpty(Model.AddressStreet))
                            {
                                <br /><small class="text-muted"><i class="fas fa-home me-1"></i>@Model.AddressStreet, @Model.AddressPostalCode @Model.AddressCity</small>
                            }
                            @if (Model.ParentId.HasValue)
                            {
                                <br />
                                <a asp-controller="Parents" asp-action="Edit" asp-route-id="@Model.ParentId"
                                   asp-route-returnUrl="@Url.Action("Details", "Bookings", new { id = Model.Id })"
                                   class="btn btn-sm btn-outline-secondary mt-1">
                                    <i class="fas fa-edit me-1"></i>@Localizer["Bookings.EditParentAddress"]
                                </a>
                            }
                        </dd>
                    </dl>

                    <hr />

                    <h6 class="mb-3 text-primary"><i class="fas fa-info-circle me-2"></i>@Localizer["Activities.GeneralInformation"]</h6>

                    <dl class="row">
                        <dt class="col-sm-4">@Localizer["Bookings.BookingDate"]</dt>
                        <dd class="col-sm-8">@Model.BookingDate.ToString("dd/MM/yyyy")</dd>

                        <dt class="col-sm-4">@Localizer["Group"]</dt>
                        <dd class="col-sm-8">
                            <form asp-action="UpdateGroup" asp-route-id="@Model.Id" method="post" class="auto-submit-form" style="max-width: 260px;">
                                @Html.AntiForgeryToken()
                                <select name="groupId" class="form-select form-select-sm" asp-items="ViewBag.Groups">
                                    <option value="">@Localizer["NoGroupOptional"]</option>
                                </select>
                            </form>
                        </dd>
                    </dl>

                    <hr />

                    <h6 class="mb-3 text-primary"><i class="fas fa-check-circle me-2"></i>@Localizer["Status"]</h6>

                    <dl class="row">
                        <dt class="col-sm-4">@Localizer["Confirmation"]</dt>
                        <dd class="col-sm-8">
                            <span class="badge @(Model.IsConfirmed ? "bg-success" : "bg-warning")">
                                @(Model.IsConfirmed ? Localizer["Confirmed"] : Localizer["Pending"])
                            </span>
                        </dd>

                        <dt class="col-sm-4">@Localizer["Bookings.MedicalSheetReceived"]</dt>
                        <dd class="col-sm-8">
                            <form asp-action="UpdateMedicalSheet" asp-route-id="@Model.Id" method="post" class="auto-submit-form" style="max-width: 200px;">
                                @Html.AntiForgeryToken()
                                <select name="isMedicalSheet" class="form-select form-select-sm">
                                    <option value="true" selected="@Model.IsMedicalSheet">@Localizer["Received"]</option>
                                    <option value="false" selected="@(!Model.IsMedicalSheet)">@Localizer["NotReceived"]</option>
                                </select>
                            </form>
                        </dd>

                        <dt class="col-sm-4">@Localizer["Financial.PaymentStatus"]</dt>
                        <dd class="col-sm-8">
                            @{
                                var paymentStatusBadge = Model.PaymentStatus switch
                                {
                                    PaymentStatus.Paid => "bg-success",
                                    PaymentStatus.PartiallyPaid => "bg-warning",
                                    PaymentStatus.NotPaid => "bg-danger",
                                    _ => "bg-secondary"
                                };
                                var paymentStatusText = Model.PaymentStatus switch
                                {
                                    PaymentStatus.Paid => Localizer["PaymentStatus.Paid"],
                                    PaymentStatus.PartiallyPaid => Localizer["PaymentStatus.PartiallyPaid"],
                                    PaymentStatus.NotPaid => Localizer["PaymentStatus.NotPaid"],
                                    _ => ""
                                };
                            }
                            <span class="badge @paymentStatusBadge">@paymentStatusText</span>
                        </dd>
                    </dl>

                    <hr />

                    <h6 class="mb-3 text-primary"><i class="fas fa-euro-sign me-2"></i>@Localizer["Financial.Information"]</h6>

                    @{
                        var balance = Model.TotalAmount - Model.PaidAmount;
                        var balanceClass = balance > 0 ? "text-danger" : "text-success";
                    }

                    <div class="d-flex align-items-stretch mb-2" style="max-width: 320px;">
                        <div class="bg-light border rounded-start px-2 py-1 small text-muted flex-grow-1">@Localizer["Bookings.ExpectedTotalToPay"]</div>
                        <div class="border-top border-bottom px-2 py-1 text-end" style="min-width: 90px;">@Model.TotalAmount.ToString("N2")</div>
                        <div class="bg-primary text-white rounded-end px-2 py-1">€</div>
                    </div>

                    @if (Model.TotalExcursionsAmount > 0)
                    {
                        <div class="d-flex align-items-stretch mb-2" style="max-width: 320px;">
                            <div class="bg-light border rounded-start px-2 py-1 small text-muted flex-grow-1">@Localizer["Financial.TotalExcursionsAmount"]</div>
                            <div class="border-top border-bottom px-2 py-1 text-end" style="min-width: 90px;">@Model.TotalExcursionsAmount.ToString("N2")</div>
                            <div class="bg-primary text-white rounded-end px-2 py-1">€</div>
                        </div>
                    }

                    <div class="d-flex justify-content-between align-items-center mt-3 mb-2">
                        <h6 class="mb-0 text-primary"><i class="fas fa-receipt me-2"></i>@Localizer["Bookings.PaymentHistory"]</h6>
                        <a asp-controller="Payments" asp-action="Create" asp-route-bookingId="@Model.Id" class="btn btn-sm btn-outline-primary">
                            <i class="fas fa-plus me-1"></i>@Localizer["Payments.AddPayment"]
                        </a>
                    </div>

                    @if (Model.Payments.Any())
                    {
                        @foreach (var payment in Model.Payments)
                        {
                            <div class="d-flex align-items-stretch mb-2" style="max-width: 320px;">
                                <a asp-controller="Payments" asp-action="Details" asp-route-id="@payment.Id"
                                   class="bg-light border rounded-start px-2 py-1 small flex-grow-1 text-decoration-none">
                                    @payment.PaymentDate.ToString("dd/MM/yyyy")
                                    <span class="text-muted">— @Localizer[$"PaymentMethod.{payment.PaymentMethod}"]</span>
                                </a>
                                <div class="border-top border-bottom px-2 py-1 text-end text-success" style="min-width: 90px;">@payment.Amount.ToString("N2")</div>
                                <div class="bg-primary text-white rounded-end px-2 py-1">€</div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="alert alert-info py-2">
                            <i class="fas fa-info-circle me-2"></i>@Localizer["Bookings.NoPaymentsYet"]
                        </div>
                    }

                    <div class="d-flex align-items-stretch mt-3 mb-2" style="max-width: 320px;">
                        <div class="bg-light border rounded-start px-2 py-1 small text-muted flex-grow-1">@Localizer["Bookings.TotalPayments"]</div>
                        <div class="border-top border-bottom px-2 py-1 text-end text-success"><strong>@Model.PaidAmount.ToString("N2")</strong></div>
                        <div class="bg-primary text-white rounded-end px-2 py-1">€</div>
                    </div>

                    <div class="d-flex align-items-stretch mb-2" style="max-width: 320px;">
                        <div class="bg-light border rounded-start px-2 py-1 small text-muted flex-grow-1">@Localizer["Financial.Balance"]</div>
                        <div class="border-top border-bottom px-2 py-1 text-end @balanceClass" style="min-width: 90px;"><strong>@balance.ToString("N2")</strong></div>
                        <div class="bg-primary text-white rounded-end px-2 py-1">€</div>
                    </div>

                    @if (Model.IsConfirmed)
                    {
                    <hr />

                    <h6 class="mb-3 text-primary"><i class="fas fa-calendar-week me-2"></i>@Localizer["Bookings.ReservedDays"]</h6>

                    @if (Model.AllActivityDays.Any())
                    {
                        <div class="row g-3">
                            @foreach (var week in Model.AllActivityDays)
                            {
                                <div class="col-md-6 col-lg-4">
                                    <div class="card h-100">
                                        <div class="card-header bg-light">
                                            <i class="fas fa-calendar me-2"></i>@week.WeekLabel
                                            <small class="text-muted ms-2">(@week.StartDate.ToString("dd/MM") - @week.EndDate.ToString("dd/MM/yyyy"))</small>
                                        </div>
                                        <div class="card-body p-0">
                                            <table class="table table-sm mb-0">
                                                <thead class="table-light">
                                                    <tr>
                                                        <th></th>
                                                        <th class="text-center small fw-normal text-muted">@Localizer["Bookings.Planned"]</th>
                                                        <th class="text-center small fw-normal text-muted">@Localizer["Present"]</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @foreach (var day in week.Days)
                                                    {
                                                        var dayName = day.DayOfWeek switch
                                                        {
                                                            DayOfWeek.Monday => Localizer["DayOfWeek.Monday"],
                                                            DayOfWeek.Tuesday => Localizer["DayOfWeek.Tuesday"],
                                                            DayOfWeek.Wednesday => Localizer["DayOfWeek.Wednesday"],
                                                            DayOfWeek.Thursday => Localizer["DayOfWeek.Thursday"],
                                                            DayOfWeek.Friday => Localizer["DayOfWeek.Friday"],
                                                            DayOfWeek.Saturday => Localizer["DayOfWeek.Saturday"],
                                                            DayOfWeek.Sunday => Localizer["DayOfWeek.Sunday"],
                                                            _ => ""
                                                        };
                                                        var isWeekend = day.DayOfWeek == DayOfWeek.Saturday || day.DayOfWeek == DayOfWeek.Sunday;
                                                        var bgClass = isWeekend ? "bg-light" : "";

                                                        <tr class="@bgClass">
                                                            <td>
                                                                <strong>@dayName</strong>
                                                                <small class="text-muted ms-1">@day.Date.ToString("dd/MM")</small>
                                                            </td>
                                                            <td class="text-center">
                                                                @if (day.IsReserved)
                                                                {
                                                                    <i class="fas fa-check-circle text-primary"></i>
                                                                }
                                                                else
                                                                {
                                                                    <i class="far fa-circle text-muted"></i>
                                                                }
                                                            </td>
                                                            <td class="text-center">
                                                                @if (day.IsPresent)
                                                                {
                                                                    <i class="fas fa-check-circle text-success"></i>
                                                                }
                                                                else
                                                                {
                                                                    <i class="far fa-circle text-muted"></i>
                                                                }
                                                            </td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-info">
                            <i class="fas fa-info-circle me-2"></i>@Localizer["Bookings.NoDaysReserved"]
                        </div>
                    }
                    }

                    @if (Model.Questions.Any())
                    {
                        <hr />

                        <h6 class="mb-3 text-primary"><i class="fas fa-question-circle me-2"></i>@Localizer["Bookings.QuestionsSection"]</h6>

                        <div class="table-responsive">
                            <table class="table table-hover">
                                <thead class="table-light">
                                    <tr>
                                        <th scope="col" style="width: 40%;">@Localizer["ActivityQuestions.QuestionText"]</th>
                                        <th scope="col" style="width: 20%;">@Localizer["ActivityQuestions.QuestionType"]</th>
                                        <th scope="col" style="width: 40%;">@Localizer["Bookings.Answer"]</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var question in Model.Questions)
                                    {
                                        <tr>
                                            <td>
                                                <strong>@question.QuestionText</strong>
                                                @if (question.IsRequired)
                                                {
                                                    <span class="badge bg-danger ms-1" style="font-size: 0.65rem;">@Localizer["Required"]</span>
                                                }
                                            </td>
                                            <td>
                                                <span class="badge bg-primary">@Localizer[$"Enum.QuestionType.{question.QuestionType}"]</span>
                                            </td>
                                            <td>
                                                @if (string.IsNullOrWhiteSpace(question.AnswerText))
                                                {
                                                    <span class="badge bg-secondary">@Localizer["Bookings.NoAnswerProvided"]</span>
                                                }
                                                else
                                                {
                                                    @question.AnswerText
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }

                    <hr />

                    <div class="mt-4">
                        <a asp-action="Index" class="btn btn-outline-secondary text-nowrap">
                            <i class="fas fa-arrow-left me-2"></i>@Localizer["BackToList"]
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card shadow">
                <div class="card-header">
                    <h6 class="mb-0"><i class="fas fa-chart-bar me-2"></i>@Localizer["Statistics"]</h6>
                </div>
                <div class="card-body">
                    <ul class="list-group list-group-flush">
                        <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                            <span><i class="fas fa-calendar-day me-2 text-primary"></i>@Localizer["BookedDays"]</span>
                            <span class="badge bg-primary rounded-pill">@Model.DaysCount</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                            <span><i class="fas fa-question-circle me-2 text-primary"></i>@Localizer["QuestionAnswers"]</span>
                            <span class="badge bg-primary rounded-pill">@Model.QuestionAnswersCount</span>
                        </li>
                    </ul>
                </div>
            </div>

            @if (!Model.IsMedicalSheet)
            {
                <div class="card shadow mt-3">
                    <div class="card-header bg-danger">
                        <h6 class="mb-0" style="color: white !important;"><i class="fas fa-file-medical me-2"></i>@Localizer["Bookings.MedicalSheetReceived"]</h6>
                    </div>
                    <div class="card-body">
                        <p class="mb-2">@Localizer["Bookings.MedicalSheetNotReceived"]</p>
                        <div class="form-text mb-2">@Localizer["Bookings.ContactParentForMedicalSheet"]</div>
                    </div>
                </div>
            }
        </div>
    </div>

    @* Audit Information *@
    <div class="mt-4 pt-3 border-top">
        <small class="text-muted" style="font-weight: 300;">
            @Localizer["Audit.CreatedBy"] <strong>@Model.CreatedByDisplayName</strong>
            @Localizer["Audit.On"] @Model.CreatedAt.ToString("dd/MM/yyyy")
            @Localizer["Audit.At"] @Model.CreatedAt.ToString("HH:mm")

            @if (Model.ModifiedAt.HasValue)
            {
                <br />
                @Localizer["Audit.ModifiedBy"] <strong>@(Model.ModifiedByDisplayName ?? "System")</strong>
                @Localizer["Audit.On"] @Model.ModifiedAt.Value.ToString("dd/MM/yyyy")
                @Localizer["Audit.At"] @Model.ModifiedAt.Value.ToString("HH:mm")
            }
        </small>
    </div>
</div>

@section Scripts {
    <script>
        // Groupe / Fiche médicale: submit as soon as the coordinator picks a new value, no
        // separate "save" button needed.
        $(document).ready(function () {
            $('.auto-submit-form select').on('change', function () {
                $(this).closest('form').trigger('submit');
            });
        });
    </script>
}
