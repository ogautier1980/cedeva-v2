@model Cedeva.Website.Features.Home.ViewModels.DashboardViewModel
@{
    ViewData["Title"] = Localizer["Home.Dashboard"];
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="fas fa-tachometer-alt me-2"></i>@Localizer["Home.Dashboard"]</h2>
        <div class="text-muted">
            <i class="fas fa-clock me-1"></i>@DateTime.Now.ToString("dddd dd MMMM yyyy")
        </div>
    </div>

    <div class="card shadow">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h6 class="mb-0"><i class="fas fa-calendar-alt me-2"></i>@Localizer["Home.RecentActivities"]</h6>
            <a href="/Activities" class="btn btn-sm btn-primary">@Localizer["Home.ViewAll"]</a>
        </div>
        <div class="card-body">
            @if (Model.RecentActivities.Any())
            {
                <div class="list-group list-group-flush">
                    @foreach (var activity in Model.RecentActivities)
                    {
                        <div class="list-group-item border-0 px-0">
                            <div class="d-flex w-100 justify-content-between align-items-start">
                                <div class="flex-grow-1">
                                    <a asp-controller="ActivityManagement" asp-action="Index" asp-route-id="@activity.ActivityId" class="text-decoration-none">
                                        <h6 class="mb-1">@activity.Name</h6>
                                    </a>
                                    <small class="text-muted">
                                        <i class="fas fa-calendar me-1"></i>
                                        @activity.StartDate.ToString("dd/MM/yyyy") - @activity.EndDate.ToString("dd/MM/yyyy")
                                    </small>
                                    <br />
                                    <small class="text-muted">@activity.BookingsCount @Localizer["Home.BookingsCount"]</small>
                                </div>
                                <a href="/Activities/Details/@activity.ActivityId" class="btn btn-sm btn-outline-primary">
                                    <i class="fas fa-cog me-1"></i>@Localizer["Home.Manage"]
                                </a>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="alert alert-info mb-0">
                    <i class="fas fa-info-circle me-2"></i>@Localizer["Home.NoActivities"]
                </div>
            }
        </div>
    </div>

    <div class="card shadow mt-4">
        <div class="card-header">
            <h6 class="mb-0"><i class="fas fa-sliders-h me-2"></i>@Localizer["Home.GeneralSettings"]</h6>
        </div>
        <div class="card-body">
            <div class="row row-cols-2 row-cols-md-3 row-cols-lg-4 g-2">
                <div class="col">
                    <a href="/Activities" class="btn btn-outline-primary text-start w-100">
                        <i class="fas fa-calendar-alt me-2"></i>@Localizer["Activities"]
                    </a>
                </div>
                <div class="col">
                    <a href="/Bookings" class="btn btn-outline-primary text-start w-100">
                        <i class="fas fa-clipboard-list me-2"></i>@Localizer["Bookings"]
                    </a>
                </div>
                <div class="col">
                    <a href="/Children" class="btn btn-outline-primary text-start w-100">
                        <i class="fas fa-child me-2"></i>@Localizer["Children"]
                    </a>
                </div>
                <div class="col">
                    <a href="/Parents" class="btn btn-outline-primary text-start w-100">
                        <i class="fas fa-user-friends me-2"></i>@Localizer["Parents"]
                    </a>
                </div>
                <div class="col">
                    <a href="/TeamMembers" class="btn btn-outline-primary text-start w-100">
                        <i class="fas fa-user-tie me-2"></i>@Localizer["TeamMembers"]
                    </a>
                </div>
                <div class="col">
                    <a href="/Contacts" class="btn btn-outline-primary text-start w-100">
                        <i class="fas fa-address-book me-2"></i>@Localizer["Contacts"]
                    </a>
                </div>
                <div class="col">
                    <a href="/EmailTemplates" class="btn btn-outline-primary text-start w-100">
                        <i class="fas fa-file-alt me-2"></i>@Localizer["EmailTemplate.LibraryMenu"]
                    </a>
                </div>
                <div class="col">
                    <a href="/ExpenseCategories" class="btn btn-outline-primary text-start w-100">
                        <i class="fas fa-tags me-2"></i>@Localizer["ExpenseCategory.Title"]
                    </a>
                </div>
                <div class="col">
                    <a href="/Import" class="btn btn-outline-primary text-start w-100">
                        <i class="fas fa-file-import me-2"></i>@Localizer["Import.Title"]
                    </a>
                </div>
            </div>
            @if (User.IsInRole("Admin"))
            {
                <hr />
                <div class="text-uppercase text-muted small mb-2">@Localizer["Layout.Administration"]</div>
                <div class="row row-cols-2 row-cols-md-3 row-cols-lg-4 g-2">
                    <div class="col">
                        <a href="/Organisations" class="btn btn-outline-secondary text-start w-100">
                            <i class="fas fa-building me-2"></i>@Localizer["Organisations"]
                        </a>
                    </div>
                    <div class="col">
                        <a href="/Users" class="btn btn-outline-secondary text-start w-100">
                            <i class="fas fa-users-cog me-2"></i>@Localizer["Users"]
                        </a>
                    </div>
                </div>
            }
        </div>
    </div>
</div>
