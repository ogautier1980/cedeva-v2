@model Cedeva.Website.Features.Home.ViewModels.DashboardViewModel
@{
    ViewData["Title"] = Localizer["Home.Dashboard"];
}

<div class="container-fluid">
    <div class="card shadow">
        <div class="card-header">
            <h6 class="mb-0"><i class="fas fa-calendar-alt me-2"></i>@Localizer["Home.RecentActivities"]</h6>
        </div>
        <div class="card-body">
            @if (Model.RecentActivities.Any())
            {
                <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 row-cols-xl-4 g-3">
                    @foreach (var activity in Model.RecentActivities)
                    {
                        <div class="col">
                            <a asp-controller="ActivityManagement" asp-action="Index" asp-route-id="@activity.ActivityId"
                               class="btn btn-outline-primary w-100 h-100 py-4 d-flex flex-column justify-content-center">
                                <span class="fw-bold fs-5">@activity.Name</span>
                                <span class="small">
                                    <i class="fas fa-calendar me-1"></i>
                                    @activity.StartDate.ToString("dd/MM/yyyy") - @activity.EndDate.ToString("dd/MM/yyyy")
                                </span>
                            </a>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="alert alert-info mb-0">
                    <i class="fas fa-info-circle me-2"></i>@Localizer["Home.NoActivities"]
                </div>
            }

            <div class="d-flex justify-content-between gap-2 mt-4">
                <div class="d-flex gap-2">
                    <a asp-controller="ActivityWizard" asp-action="Step1" class="btn btn-success text-nowrap">
                        <i class="fas fa-plus me-2"></i>@Localizer["ActivityWizard.CreateNewActivity"]
                    </a>
                    <form asp-controller="Account" asp-action="Logout" method="post">
                        <button type="submit" class="btn btn-outline-secondary text-nowrap">
                            <i class="fas fa-sign-out-alt me-2"></i>@Localizer["Layout.Logout"]
                        </button>
                    </form>
                </div>
                <a href="/Activities" class="btn btn-primary text-nowrap">@Localizer["Home.ViewAll"]</a>
            </div>
        </div>
    </div>
</div>
