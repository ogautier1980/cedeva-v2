@model Cedeva.Website.Features.Activities.ViewModels.WizardStep4ViewModel
@{
    ViewData["Title"] = Localizer["ActivityWizard.Step4Title"];
}

<div class="container-fluid">
    @await Html.PartialAsync("_WizardProgress", (4, Model.ActivityId, Model.WizardMaxStepReached))
    <div class="row">
        <div class="col-lg-8">
            <div class="card shadow">
                <div class="card-header">
                    <h5 class="mb-0"><i class="fas fa-ban me-2"></i>@Model.ActivityName — @Localizer["ActivityWizard.Step4Title"]</h5>
                </div>
                <div class="card-body">
                    <form asp-action="Step4" method="post">
                        <input type="hidden" asp-for="ActivityId" />
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                        <h6 class="text-primary mb-3">@Localizer["Activities.PostalCodeRestrictions"]</h6>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label for="IncludedPostalCodes" class="form-label">@Localizer["Activities.IncludedPostalCodes"]</label>
                                <input asp-for="IncludedPostalCodes" class="form-control" id="IncludedPostalCodes" placeholder="5030,5031,5032" />
                                <span asp-validation-for="IncludedPostalCodes" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label for="ExcludedPostalCodes" class="form-label">@Localizer["Activities.ExcludedPostalCodes"]</label>
                                <input asp-for="ExcludedPostalCodes" class="form-control" id="ExcludedPostalCodes" />
                                <span asp-validation-for="ExcludedPostalCodes" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="mb-3">
                            <label for="PostalCodeErrorMessage" class="form-label">@Localizer["Activity.PostalCodeErrorMessage"]</label>
                            <input asp-for="PostalCodeErrorMessage" class="form-control" id="PostalCodeErrorMessage" />
                            <span asp-validation-for="PostalCodeErrorMessage" class="text-danger"></span>
                        </div>

                        <hr />

                        <h6 class="text-primary mb-3">@Localizer["Activity.MaxChildrenPerDay"]</h6>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label for="MaxChildrenPerDay" class="form-label">@Localizer["Activity.MaxChildrenPerDay"]</label>
                                <input asp-for="MaxChildrenPerDay" type="number" min="1" class="form-control" id="MaxChildrenPerDay" />
                                <span asp-validation-for="MaxChildrenPerDay" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label for="FullMessage" class="form-label">@Localizer["Activity.FullMessage"]</label>
                                <input asp-for="FullMessage" class="form-control" id="FullMessage" placeholder="COMPLET" />
                                <span asp-validation-for="FullMessage" class="text-danger"></span>
                            </div>
                        </div>

                        <hr />

                        <h6 class="text-primary mb-3">@Localizer["Activity.BirthYearQuotas"]</h6>
                        <p class="text-muted small">@Localizer["Activity.BirthYearQuotasHelp"]</p>
                        <div class="mb-3">
                            <label for="BirthYearQuotaExceededMessage" class="form-label">@Localizer["Activity.BirthYearQuotaExceededMessage"]</label>
                            <input asp-for="BirthYearQuotaExceededMessage" class="form-control" id="BirthYearQuotaExceededMessage" />
                            <span asp-validation-for="BirthYearQuotaExceededMessage" class="text-danger"></span>
                        </div>

                        @if (Model.BirthYearQuotas.Any())
                        {
                            <table class="table table-sm">
                                <thead>
                                    <tr>
                                        <th>@Localizer["Activity.BirthYear"]</th>
                                        <th>@Localizer["Activity.MaxChildren"]</th>
                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var quota in Model.BirthYearQuotas)
                                    {
                                        <tr>
                                            <td>@quota.BirthYear</td>
                                            <td>@quota.MaxChildren</td>
                                            <td class="text-end">
                                                <button type="submit" class="btn btn-sm btn-outline-danger"
                                                        formaction="@Url.Action("RemoveBirthYearQuota", new { id = Model.ActivityId, quotaId = quota.Id })"
                                                        formmethod="post" formnovalidate>
                                                    <i class="fas fa-trash"></i>
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }

                        <div class="d-flex align-items-end gap-2 mb-3">
                            <div>
                                <label for="birthYear" class="form-label mb-1">@Localizer["Activity.BirthYear"]</label>
                                <input type="number" name="birthYear" id="birthYear" class="form-control form-control-sm" min="1900" max="2100" />
                            </div>
                            <div>
                                <label for="maxChildren" class="form-label mb-1">@Localizer["Activity.MaxChildren"]</label>
                                <input type="number" name="maxChildren" id="maxChildren" class="form-control form-control-sm" min="1" />
                            </div>
                            <button type="submit" class="btn btn-outline-primary btn-sm"
                                    formaction="@Url.Action("AddBirthYearQuota", new { id = Model.ActivityId })"
                                    formmethod="post" formnovalidate>
                                <i class="fas fa-plus me-1"></i>@Localizer["Add"]
                            </button>
                        </div>

                        <hr />

                        <div class="d-flex justify-content-between gap-2 mt-4">
                            <a asp-action="Step3" asp-route-id="@Model.ActivityId" class="btn btn-outline-secondary">
                                <i class="fas fa-arrow-left me-1"></i>@Localizer["Previous"]
                            </a>
                            <button type="submit" class="btn btn-primary">
                                <i class="fas fa-arrow-right me-1"></i>@Localizer["Next"]
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
