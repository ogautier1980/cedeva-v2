@model Cedeva.Website.Features.Activities.ViewModels.WizardStep2ViewModel
@{
    ViewData["Title"] = Localizer["ActivityWizard.Step2Title"];
}

<div class="container-fluid">
    @await Html.PartialAsync("_WizardProgress", (2, Model.ActivityId))
    <div class="row">
        <div class="col-lg-10">
            <div class="card shadow">
                <div class="card-header">
                    <h5 class="mb-0"><i class="fas fa-calendar-week me-2"></i>@Model.ActivityName — @Localizer["ActivityWizard.Step2Title"]</h5>
                </div>
                <div class="card-body">
                    <div class="d-flex flex-wrap align-items-end gap-3 mb-3">
                        <form id="addDatesForm" asp-action="AddDate" asp-route-id="@Model.ActivityId" method="post">
                            @Html.AntiForgeryToken()
                        </form>
                        <button type="button" class="btn btn-outline-primary btn-sm" data-bs-toggle="modal" data-bs-target="#addDatesModal">
                            <i class="fas fa-calendar-plus me-1"></i>@Localizer["ActivityWizard.AddDates"]
                        </button>

                        <div class="form-check form-switch ms-auto">
                            <input class="form-check-input" type="checkbox" id="groupByWeekToggle">
                            <label class="form-check-label" for="groupByWeekToggle">@Localizer["ActivityWizard.GroupByWeek"]</label>
                        </div>
                    </div>

                    <form asp-action="Step2Next" asp-route-id="@Model.ActivityId" method="post">
                        @Html.AntiForgeryToken()
                        <div class="row g-3" id="weeksContainer">
                            @foreach (var week in Model.Weeks)
                            {
                                var weekdayDays = week.Days.Where(d => !d.IsWeekend).OrderBy(d => d.Date).ToList();
                                var weekdayIds = weekdayDays.Select(d => d.DayId).ToList();
                                var rangeLabel = weekdayDays.Any()
                                    ? $"{weekdayDays.First().Date:dd/MM} - {weekdayDays.Last().Date:dd/MM}"
                                    : Localizer["ActivityWizard.GroupByWeek"].Value;
                                <div class="col-md-6 col-lg-4">
                                    <div class="card h-100">
                                        <div class="card-header bg-light">
                                            <i class="fas fa-calendar me-2"></i>Semaine @week.WeekNumber
                                        </div>
                                        <div class="card-body p-0">
                                            <div class="list-group list-group-flush">
                                                <div class="list-group-item py-2 week-master-row d-none" data-weekday-ids="@string.Join(",", weekdayIds)">
                                                    <div class="form-check">
                                                        <input class="form-check-input week-master-checkbox" type="checkbox" id="week_@week.WeekNumber" checked />
                                                        <label class="form-check-label" for="week_@week.WeekNumber">
                                                            <strong>@rangeLabel</strong>
                                                            <span class="text-muted small week-master-exceptions"></span>
                                                        </label>
                                                    </div>
                                                </div>
                                                @foreach (var day in week.Days)
                                                {
                                                    var bgClass = day.IsWeekend ? "bg-light" : "";
                                                    var rowClass = day.IsWeekend ? "day-row" : "day-row weekday-row";
                                                    <div class="list-group-item @bgClass py-2 @rowClass">
                                                        <div class="form-check">
                                                            <input class="form-check-input day-checkbox" type="checkbox"
                                                                   name="ActiveDayIds" value="@day.DayId"
                                                                   id="day_@day.DayId" @(day.IsActive ? "checked" : "") />
                                                            <label class="form-check-label" for="day_@day.DayId">
                                                                <strong>@day.Date.ToString("dddd", new System.Globalization.CultureInfo("fr-BE"))</strong>
                                                                <small class="text-muted ms-1">@day.Date.ToString("dd/MM")</small>
                                                                @if (day.IsWeekend)
                                                                {
                                                                    <span class="badge bg-warning text-dark ms-1" style="font-size: 0.65rem;">Week-end</span>
                                                                }
                                                            </label>
                                                        </div>
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>

                        <div class="d-flex justify-content-between gap-2 mt-4">
                            <a asp-action="Step1" asp-route-id="@Model.ActivityId" class="btn btn-outline-secondary">
                                <i class="fas fa-arrow-left me-1"></i>@Localizer["Previous"]
                            </a>
                            <button type="submit" class="btn btn-primary">
                                <i class="fas fa-arrow-right me-1"></i>@Localizer["Next"]
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" id="addDatesModal" tabindex="-1" aria-labelledby="addDatesModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-sm">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="addDatesModalLabel">
                        <i class="fas fa-calendar-plus me-2"></i>@Localizer["ActivityWizard.AddDates"]
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <button type="button" class="btn btn-sm btn-outline-secondary" id="calPrevMonth"><i class="fas fa-chevron-left"></i></button>
                        <strong id="calMonthLabel"></strong>
                        <button type="button" class="btn btn-sm btn-outline-secondary" id="calNextMonth"><i class="fas fa-chevron-right"></i></button>
                    </div>
                    <div id="calWeekdays" class="d-grid mb-1" style="grid-template-columns: repeat(7, 1fr);"></div>
                    <div id="calDays" class="d-grid" style="grid-template-columns: repeat(7, 1fr); gap: 2px;"></div>
                    <p class="text-muted small mt-2 mb-0">@Localizer["ActivityWizard.AddDatesHelp"]</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">@Localizer["Cancel"]</button>
                    <button type="button" class="btn btn-primary" id="calConfirmBtn" disabled>@Localizer["ActivityWizard.AddDates"]</button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // "Regrouper par semaine" is a pure display convenience: when on, weekday checkboxes
        // (Mon-Fri) are hidden and replaced by one master checkbox per week that checks/unchecks
        // them all together. Nothing is persisted server-side — it's just less clicking.
        var sauf = @Json.Serialize(Localizer["ActivityWizard.Except"].Value);

        function refreshWeekMasterRow(masterRow) {
            var ids = masterRow.dataset.weekdayIds.split(',').filter(Boolean);
            var master = masterRow.querySelector('.week-master-checkbox');
            var exceptionsSpan = masterRow.querySelector('.week-master-exceptions');
            var uncheckedLabels = [];
            var checkedCount = 0;
            ids.forEach(function (id) {
                var cb = document.getElementById('day_' + id);
                if (!cb) return;
                if (cb.checked) {
                    checkedCount++;
                } else {
                    var label = document.querySelector('label[for="day_' + id + '"] small');
                    uncheckedLabels.push(label ? label.textContent.trim() : id);
                }
            });
            master.checked = checkedCount === ids.length;
            master.indeterminate = checkedCount > 0 && checkedCount < ids.length;
            exceptionsSpan.textContent = uncheckedLabels.length ? (' (' + sauf + ' ' + uncheckedLabels.join(', ') + ')') : '';
        }

        document.getElementById('groupByWeekToggle').addEventListener('change', function () {
            var grouped = this.checked;
            document.querySelectorAll('.weekday-row').forEach(function (row) {
                row.classList.toggle('d-none', grouped);
            });
            document.querySelectorAll('.week-master-row').forEach(function (row) {
                row.classList.toggle('d-none', !grouped);
                if (grouped) refreshWeekMasterRow(row);
            });
        });

        document.querySelectorAll('.week-master-checkbox').forEach(function (master) {
            master.addEventListener('change', function () {
                var row = this.closest('.week-master-row');
                var ids = row.dataset.weekdayIds.split(',').filter(Boolean);
                ids.forEach(function (id) {
                    var cb = document.getElementById('day_' + id);
                    if (cb) cb.checked = master.checked;
                });
                refreshWeekMasterRow(row);
            });
        });

        // Simple custom calendar for picking a single date or a date range to add to the activity.
        (function () {
            var locale = document.documentElement.lang || 'fr';
            var monthLabel = document.getElementById('calMonthLabel');
            var weekdaysEl = document.getElementById('calWeekdays');
            var daysEl = document.getElementById('calDays');
            var confirmBtn = document.getElementById('calConfirmBtn');
            var modalEl = document.getElementById('addDatesModal');

            var today = new Date();
            var viewYear = today.getFullYear();
            var viewMonth = today.getMonth();
            var rangeStart = null;
            var rangeEnd = null;

            function toDateOnly(y, m, d) { return new Date(y, m, d); }

            function isSameDay(a, b) {
                return a && b && a.getFullYear() === b.getFullYear() && a.getMonth() === b.getMonth() && a.getDate() === b.getDate();
            }

            function isInRange(d) {
                if (!rangeStart || !rangeEnd) return false;
                return d > rangeStart && d < rangeEnd;
            }

            function renderWeekdayHeader() {
                weekdaysEl.innerHTML = '';
                var base = new Date(2024, 0, 1); // a Monday
                for (var i = 0; i < 7; i++) {
                    var d = new Date(2024, 0, 1 + i);
                    var label = new Intl.DateTimeFormat(locale, { weekday: 'narrow' }).format(d);
                    var span = document.createElement('div');
                    span.className = 'text-center text-muted small';
                    span.textContent = label;
                    weekdaysEl.appendChild(span);
                }
            }

            function render() {
                monthLabel.textContent = new Intl.DateTimeFormat(locale, { month: 'long', year: 'numeric' }).format(new Date(viewYear, viewMonth, 1));
                daysEl.innerHTML = '';

                var firstOfMonth = new Date(viewYear, viewMonth, 1);
                // Monday-first grid: convert JS Sunday=0 to Monday=0.
                var startOffset = (firstOfMonth.getDay() + 6) % 7;
                var daysInMonth = new Date(viewYear, viewMonth + 1, 0).getDate();

                for (var i = 0; i < startOffset; i++) {
                    daysEl.appendChild(document.createElement('div'));
                }

                for (var day = 1; day <= daysInMonth; day++) {
                    var d = toDateOnly(viewYear, viewMonth, day);
                    var btn = document.createElement('button');
                    btn.type = 'button';
                    btn.textContent = day;
                    btn.className = 'btn btn-sm p-1';
                    if (isSameDay(d, rangeStart) || isSameDay(d, rangeEnd)) {
                        btn.classList.add('btn-primary');
                    } else if (isInRange(d)) {
                        btn.classList.add('btn-light', 'border-primary');
                    } else {
                        btn.classList.add('btn-outline-light', 'text-dark');
                    }
                    btn.addEventListener('click', function (clicked) {
                        return function () { onDayClick(clicked); };
                    }(d));
                    daysEl.appendChild(btn);
                }
            }

            function onDayClick(d) {
                if (!rangeStart || rangeEnd) {
                    rangeStart = d;
                    rangeEnd = null;
                } else if (d < rangeStart) {
                    rangeStart = d;
                    rangeEnd = null;
                } else if (isSameDay(d, rangeStart)) {
                    rangeEnd = null;
                } else {
                    rangeEnd = d;
                }
                confirmBtn.disabled = !rangeStart;
                render();
            }

            document.getElementById('calPrevMonth').addEventListener('click', function () {
                viewMonth--;
                if (viewMonth < 0) { viewMonth = 11; viewYear--; }
                render();
            });
            document.getElementById('calNextMonth').addEventListener('click', function () {
                viewMonth++;
                if (viewMonth > 11) { viewMonth = 0; viewYear++; }
                render();
            });

            modalEl.addEventListener('show.bs.modal', function () {
                rangeStart = null;
                rangeEnd = null;
                confirmBtn.disabled = true;
                var now = new Date();
                viewYear = now.getFullYear();
                viewMonth = now.getMonth();
                render();
            });

            confirmBtn.addEventListener('click', function () {
                if (!rangeStart) return;
                var form = document.getElementById('addDatesForm');
                form.querySelectorAll('input[name="dates"]').forEach(function (el) { el.remove(); });

                var end = rangeEnd || rangeStart;
                for (var d = new Date(rangeStart); d <= end; d.setDate(d.getDate() + 1)) {
                    var input = document.createElement('input');
                    input.type = 'hidden';
                    input.name = 'dates';
                    input.value = d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0') + '-' + String(d.getDate()).padStart(2, '0');
                    form.appendChild(input);
                }
                form.submit();
            });

            renderWeekdayHeader();
        })();
    </script>
}
