@model Cedeva.Website.Features.Activities.ViewModels.WizardStep3ViewModel
@{
    ViewData["Title"] = Localizer["ActivityWizard.Step3Title"];
}

<div class="container-fluid">
    @await Html.PartialAsync("_WizardProgress", 3)
    <div class="row">
        <div class="col-lg-8">
            <div class="card shadow">
                <div class="card-header">
                    <h5 class="mb-0"><i class="fas fa-file-contract me-2"></i>@Model.ActivityName — @Localizer["ActivityWizard.Step3Title"]</h5>
                </div>
                <div class="card-body">
                    <form asp-action="Step3" method="post">
                        <input type="hidden" asp-for="ActivityId" />
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                        <div class="mb-3">
                            <label for="RegulationLinkUrl" class="form-label">@Localizer["Activity.RegulationLinkUrl"]</label>
                            <input asp-for="RegulationLinkUrl" class="form-control" id="RegulationLinkUrl" placeholder="https://..." />
                            <span asp-validation-for="RegulationLinkUrl" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label for="RegulationAcceptanceText" class="form-label">@Localizer["Activity.RegulationAcceptanceText"]</label>
                            <input asp-for="RegulationAcceptanceText" class="form-control" id="RegulationAcceptanceText" />
                            <span asp-validation-for="RegulationAcceptanceText" class="text-danger"></span>
                        </div>

                        <div class="d-flex gap-2 mt-4">
                            <button type="submit" class="btn btn-primary">
                                <i class="fas fa-save me-1"></i>@Localizer["ActivityWizard.SaveAndContinue"]
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
