@model Cedeva.Core.Entities.Excursion

@{
    ViewData["Title"] = Model.Name;
    ViewData["ActivityId"] = Model.ActivityId;
    ViewData["ActivityName"] = Model.Activity?.Name;
    ViewData["NavSection"] = "Excursions";
    ViewData["NavAction"] = "Details";
}


<div class="container-fluid py-4">
    @await Html.PartialAsync("_AlertMessages")

    <!-- Header with actions -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="h3 mb-0">@Model.Name</h2>
            <small class="text-muted">@Model.Activity?.Name</small>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-secondary">
                <i class="fas fa-edit"></i> @Localizer["Edit"]
            </a>
            <a asp-action="SendEmail" asp-route-id="@Model.Id" class="btn btn-outline-info">
                <i class="fas fa-envelope"></i> @Localizer["Excursion.SendEmailToParents"]
            </a>
            @if (Model.Registrations.Count == 0)
            {
                <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-outline-danger">
                    <i class="fas fa-trash"></i> @Localizer["Delete"]
                </a>
            }
        </div>
    </div>

    <div class="row">
        <!-- Main info card -->
        <div class="col-12">
            <div class="card shadow mb-4">
                <div class="card-header">
                    <h6 class="mb-0"><i class="fas fa-info-circle"></i> @Localizer["Excursion.GeneralInfo"]</h6>
                </div>
                <div class="card-body">
                    <dl class="row mb-0">
                        <dt class="col-sm-3">@Localizer["Field.ExcursionDate"]</dt>
                        <dd class="col-sm-9">@Model.ExcursionDate.ToString("dddd dd MMMM yyyy", new System.Globalization.CultureInfo("fr-BE"))</dd>

                        <dt class="col-sm-3">@Localizer["Field.ExcursionCost"]</dt>
                        <dd class="col-sm-9">@Model.Cost.ToString("C2")</dd>

                        <dt class="col-sm-3">@Localizer["Field.TargetGroups"]</dt>
                        <dd class="col-sm-9">
                            @foreach (var eg in Model.ExcursionGroups)
                            {
                                <span class="badge bg-secondary me-1">@eg.ActivityGroup.Label</span>
                            }
                        </dd>

                        @if (!string.IsNullOrWhiteSpace(Model.Description))
                        {
                            <dt class="col-sm-3">@Localizer["Field.Description"]</dt>
                            <dd class="col-sm-9">@Model.Description</dd>
                        }
                    </dl>
                </div>
            </div>

            <!-- Children planned that day -->
            @{
                var plannedBookings = ViewBag.PlannedBookings as List<Cedeva.Core.Entities.Booking> ?? new();
                var registeredIds = ViewBag.RegisteredBookingIds as HashSet<int> ?? new();
            }
            <div class="card shadow">
                <div class="card-header">
                    <h6 class="mb-0"><i class="fas fa-users me-2"></i>@Localizer["Excursion.PlannedChildren"]</h6>
                </div>
                <div class="card-body">
                    @if (plannedBookings.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover table-sm mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th scope="col">@Localizer["Field.FirstName"]</th>
                                        <th scope="col">@Localizer["Field.LastName"]</th>
                                        <th scope="col" class="text-center">@Localizer["Excursion.EmailSent"]</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var booking in plannedBookings)
                                    {
                                        <tr>
                                            <td>@booking.Child.FirstName</td>
                                            <td>@booking.Child.LastName</td>
                                            <td class="text-center">
                                                @if (registeredIds.Contains(booking.Id))
                                                {
                                                    <i class="fas fa-check text-success"></i>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-4">
                            <i class="fas fa-users fa-3x text-muted mb-3"></i>
                            <p class="text-muted mb-0">@Localizer["Excursion.NoPlannedChildren"]</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    @* Audit Information *@
    <div class="mt-4 pt-3 border-top">
        <small class="text-muted" style="font-weight: 300;">
            @Localizer["Audit.CreatedBy"] <strong>@ViewBag.CreatedByDisplayName</strong>
            @Localizer["Audit.On"] @Model.CreatedAt.ToString("dd/MM/yyyy")
            @Localizer["Audit.At"] @Model.CreatedAt.ToString("HH:mm")

            @if (Model.ModifiedAt.HasValue)
            {
                <br />
                @Localizer["Audit.ModifiedBy"] <strong>@(ViewBag.ModifiedByDisplayName ?? "System")</strong>
                @Localizer["Audit.On"] @Model.ModifiedAt.Value.ToString("dd/MM/yyyy")
                @Localizer["Audit.At"] @Model.ModifiedAt.Value.ToString("HH:mm")
            }
        </small>
    </div>
</div>
