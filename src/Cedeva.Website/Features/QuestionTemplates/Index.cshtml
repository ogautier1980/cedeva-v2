@model List<Cedeva.Core.Entities.OrganisationQuestionTemplate>
@{
    ViewData["Title"] = Localizer["QuestionTemplate.Title"];
}

@await Html.PartialAsync("_AlertMessages")

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2><i class="fas fa-question-circle me-2"></i>@Localizer["QuestionTemplate.Title"]</h2>
        <p class="text-muted mb-0">@Localizer["QuestionTemplate.Help"]</p>
    </div>
    <a asp-action="Create" class="btn btn-primary text-nowrap">
        <i class="fas fa-plus me-2"></i>@Localizer["QuestionTemplate.AddTemplate"]
    </a>
</div>

@if (Model.Any())
{
    <div class="card">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th scope="col">@Localizer["ActivityQuestions.QuestionText"]</th>
                            <th scope="col">@Localizer["ActivityQuestions.QuestionType"]</th>
                            <th scope="col" class="text-center">@Localizer["ActivityQuestions.IsRequired"]</th>
                            <th scope="col" class="text-end">@Localizer["Actions"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var template in Model.OrderBy(t => t.DisplayOrder))
                        {
                            <tr>
                                <td>@template.QuestionText</td>
                                <td>@Localizer[$"Enum.QuestionType.{template.QuestionType}"]</td>
                                <td class="text-center">
                                    @if (template.IsRequired)
                                    {
                                        <i class="fas fa-check text-success"></i>
                                    }
                                    else
                                    {
                                        <i class="fas fa-times text-muted"></i>
                                    }
                                </td>
                                <td class="text-end text-nowrap">
                                    <a asp-action="Edit" asp-route-id="@template.Id" class="btn btn-sm btn-outline-secondary">
                                        <i class="fas fa-edit"></i>
                                    </a>
                                    @await Html.PartialAsync("_DeleteButton", new DeleteButtonModel { Id = template.Id, ConfirmMessage = Localizer["QuestionTemplate.ConfirmDelete"].Value })
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}
else
{
    @await Html.PartialAsync("_EmptyState", new EmptyStateModel
    {
        Icon = "fa-question-circle",
        Message = Localizer["QuestionTemplate.NoTemplates"].Value,
        CreateUrl = Url.Action("Create"),
        CreateText = Localizer["QuestionTemplate.AddTemplate"].Value
    })
}
