@model Cedeva.Website.Features.Parents.ViewModels.FiscalAttestationViewModel
@{
    ViewData["Title"] = Localizer["Parents.FiscalAttestation"];
    Layout = null;
}

<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - @Model.ParentFirstName @Model.ParentLastName - @Model.FiscalYear</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <style>
        body { padding: 2rem; }
        .attestation-container { max-width: 900px; margin: 0 auto; }
        .attestation-logo { max-height: 90px; max-width: 220px; }
        .section-box { border: 1px solid #333; padding: 1rem 1.25rem; margin-bottom: 1.25rem; }
        .section-title { font-weight: bold; margin-bottom: 0.75rem; }
        .signature-zone { margin-top: 3rem; }
        .legal-notice { font-size: 0.85rem; color: #555; }
        @@media print {
            .no-print { display: none !important; }
            body { padding: 0; }
        }
    </style>
</head>
<body>
    <div class="attestation-container">
        <div class="no-print d-flex justify-content-between align-items-center mb-3">
            @if (Model.AvailableYears.Any())
            {
                <form method="get" class="d-flex align-items-center gap-2">
                    <label for="year" class="form-label mb-0">@Localizer["Parents.FiscalYear"]</label>
                    <select name="year" id="year" class="form-select form-select-sm" style="width: auto;" onchange="this.form.submit()">
                        @foreach (var y in Model.AvailableYears)
                        {
                            <option value="@y" selected="@(y == Model.FiscalYear)">@y</option>
                        }
                    </select>
                </form>
            }
            <button class="btn btn-primary" onclick="window.print()">
                <i class="fas fa-print"></i> @Localizer["Button.Print"]
            </button>
        </div>

        <div class="alert alert-warning legal-notice no-print">
            <i class="fas fa-exclamation-triangle me-1"></i>
            @Localizer["Parents.FiscalAttestationDraftWarning"]
        </div>

        @if (!string.IsNullOrWhiteSpace(Model.OrganisationLogoUrl))
        {
            <img src="@Model.OrganisationLogoUrl" alt="@Model.OrganisationName" class="attestation-logo mb-3" />
        }

        <h2 class="text-center mb-2">@Localizer["Parents.FiscalAttestationTitle"]</h2>
        <p class="text-center text-muted mb-4">@Localizer["Parents.FiscalAttestationSubtitle", Model.FiscalYear]</p>

        <p class="legal-notice">@Localizer["Parents.FiscalAttestationLegalIntro"]</p>

        <div class="section-box">
            <div class="section-title">1. @Localizer["Bookings.MutualityAttestationOrganiser"]</div>
            <p class="mb-1"><strong>@Model.OrganisationName</strong></p>
            @if (!string.IsNullOrWhiteSpace(Model.CompanyNumber))
            {
                <p class="mb-1">@Localizer["Field.CompanyNumber"]: @Model.CompanyNumber</p>
            }
            @if (!string.IsNullOrWhiteSpace(Model.ResponsibleName))
            {
                <p class="mb-1">@Localizer["Field.ResponsibleName"]: @Model.ResponsibleName</p>
            }
            @if (!string.IsNullOrWhiteSpace(Model.OrganisationAddress))
            {
                <p class="mb-0">@Localizer["Address"]: @Model.OrganisationAddress</p>
            }
        </div>

        <div class="section-box">
            <div class="section-title">2. @Localizer["Parents.FiscalAttestationBeneficiary"]</div>
            <p class="mb-1">@Localizer["Field.LastName"]: @Model.ParentLastName</p>
            <p class="mb-1">@Localizer["Field.FirstName"]: @Model.ParentFirstName</p>
            @if (!string.IsNullOrWhiteSpace(Model.ParentNationalRegisterNumber))
            {
                <p class="mb-1">@Localizer["NationalRegisterNumber"]: @Cedeva.Core.Helpers.NationalRegisterNumberHelper.Format(Model.ParentNationalRegisterNumber)</p>
            }
            @if (!string.IsNullOrWhiteSpace(Model.ParentAddress))
            {
                <p class="mb-0">@Localizer["Address"]: @Model.ParentAddress</p>
            }
        </div>

        <div class="section-box">
            <div class="section-title">3. @Localizer["Parents.FiscalAttestationDetail"]</div>
            @if (Model.Lines.Any())
            {
                <div class="table-responsive">
                    <table class="table table-sm table-bordered mb-2">
                        <thead class="table-light">
                            <tr>
                                <th>@Localizer["Field.Child"]</th>
                                <th>@Localizer["Field.BirthDate"]</th>
                                <th>@Localizer["NationalRegisterNumber"]</th>
                                <th>@Localizer["Field.Activity"]</th>
                                <th>@Localizer["Bookings.MutualityAttestationPeriod"]</th>
                                <th class="text-end">@Localizer["Parents.FiscalAttestationAmountPaid"]</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var line in Model.Lines)
                            {
                                <tr>
                                    <td>@line.ChildFirstName @line.ChildLastName</td>
                                    <td>@line.ChildBirthDate.ToString("dd-MM-yyyy")</td>
                                    <td>@(string.IsNullOrWhiteSpace(line.ChildNationalRegisterNumber) ? "—" : Cedeva.Core.Helpers.NationalRegisterNumberHelper.Format(line.ChildNationalRegisterNumber))</td>
                                    <td>@line.ActivityName</td>
                                    <td>@line.ActivityStartDate.ToString("dd-MM-yyyy") - @line.ActivityEndDate.ToString("dd-MM-yyyy")</td>
                                    <td class="text-end">@line.AmountPaid.ToString("C", new System.Globalization.CultureInfo("fr-BE"))</td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr class="fw-bold">
                                <td colspan="5" class="text-end">@Localizer["Parents.FiscalAttestationTotal"]</td>
                                <td class="text-end">@Model.TotalAmountPaid.ToString("C", new System.Globalization.CultureInfo("fr-BE"))</td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            }
            else
            {
                <p class="text-muted mb-0">@Localizer["Parents.FiscalAttestationNoLines"]</p>
            }
        </div>

        <p class="legal-notice">@Localizer["Parents.FiscalAttestationLegalFooter"]</p>

        <div class="section-box">
            <div class="section-title">4. @Localizer["Bookings.MutualityAttestationStampAndSignature"]</div>
            <p class="mb-0">@Localizer["Bookings.MutualityAttestationIssuedOn"]: @Model.IssuedDate.ToString("dd-MM-yyyy")</p>
            <div class="signature-zone"></div>
        </div>
    </div>
</body>
</html>
