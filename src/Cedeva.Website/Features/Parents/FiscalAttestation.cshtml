@model Cedeva.Website.Features.Parents.ViewModels.FiscalAttestationViewModel
@{
    ViewData["Title"] = Localizer["Parents.FiscalAttestation"];
    var data = Model.Data;
    var culture = new System.Globalization.CultureInfo("fr-BE");
    var canProduce = data.Children.Count > 0 && data.MaxDailyAmount.HasValue;
}

<div class="container-fluid">
    @await Html.PartialAsync("_AlertMessages")

    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-4">
        <div>
            <h1 class="h3 mb-0">@Localizer["Parents.FiscalAttestation"] @Model.FiscalYear</h1>
            <small class="text-muted">@data.ParentFullName — @data.Organisation.Name</small>
        </div>
        <div class="d-flex align-items-center gap-2">
            @if (Model.AvailableYears.Count > 1)
            {
                <form method="get" class="d-flex align-items-center gap-2">
                    <label for="year" class="form-label mb-0">@Localizer["Parents.FiscalYear"]</label>
                    <select name="year" id="year" class="form-select form-select-sm" style="width: auto;" onchange="this.form.submit()">
                        @foreach (var y in Model.AvailableYears)
                        {
                            <option value="@y" selected="@(y == Model.FiscalYear)">@y</option>
                        }
                    </select>
                </form>
            }
            <a asp-action="Details" asp-route-id="@Model.ParentId" class="btn btn-outline-secondary text-nowrap">
                <i class="fas fa-arrow-left me-2"></i>@Localizer["Back"]
            </a>
        </div>
    </div>

    @if (!data.MaxDailyAmount.HasValue)
    {
        <div class="alert alert-warning">
            <i class="fas fa-triangle-exclamation me-2"></i>@Localizer["FiscalAttestation.YearNotConfigured", Model.FiscalYear]
        </div>
    }

    @if (data.Children.Count > 0 && (string.IsNullOrWhiteSpace(data.Organisation.ResponsibleName) || data.Organisation.Signature == null))
    {
        <div class="alert alert-warning">
            <i class="fas fa-signature me-2"></i>@Localizer["FiscalAttestation.MissingResponsible"]
        </div>
    }

    @if (data.Children.Count == 0)
    {
        <div class="text-center py-5">
            <i class="fas fa-file-invoice fa-3x text-muted mb-3"></i>
            <p class="text-muted">@Localizer["FiscalAttestation.NothingForYear", Model.FiscalYear]</p>
        </div>
    }
    else
    {
        <div class="card shadow mb-4">
            <div class="card-header bg-primary text-white">
                <h6 class="mb-0"><i class="fas fa-file-invoice me-2"></i>@Localizer["FiscalAttestation.Content"]</h6>
            </div>
            <div class="card-body">
                <p class="text-muted small">@Localizer["FiscalAttestation.ContentHelp"]</p>
                @foreach (var child in data.Children)
                {
                    <h6 class="mt-3">@child.LastName @child.FirstName <small class="text-muted">(@child.BirthDate.ToString("dd/MM/yyyy"))</small></h6>
                    <table class="table table-sm table-hover mb-2">
                        <thead class="table-light">
                            <tr>
                                <th scope="col">@Localizer["FiscalAttestation.Activity"]</th>
                                <th scope="col">@Localizer["FiscalAttestation.Period"]</th>
                                <th scope="col" class="text-end">@Localizer["FiscalAttestation.Days"]</th>
                                <th scope="col" class="text-end">@Localizer["FiscalAttestation.Amount"]</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var period in child.Periods)
                            {
                                <tr>
                                    <td>@period.ActivityName</td>
                                    <td>@period.From.ToString("dd/MM/yyyy") – @period.To.ToString("dd/MM/yyyy")</td>
                                    <td class="text-end">@period.Days</td>
                                    <td class="text-end">@period.Amount.ToString("C", culture)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                <p class="fw-bold text-end mb-0">@Localizer["FiscalAttestation.Total"] @data.Total.ToString("C", culture)</p>
            </div>
        </div>

        @if (canProduce)
        {
            <div class="d-flex gap-2">
                <a asp-action="FiscalAttestationPdf" asp-route-id="@Model.ParentId" asp-route-year="@Model.FiscalYear"
                   class="btn btn-primary text-nowrap" target="_blank">
                    <i class="fas fa-file-pdf me-2"></i>@Localizer["FiscalAttestation.DownloadPdf"]
                </a>
                <form asp-action="SendFiscalAttestation" asp-route-id="@Model.ParentId" asp-route-year="@Model.FiscalYear" method="post">
                    <button type="submit" class="btn btn-outline-primary text-nowrap" disabled="@string.IsNullOrWhiteSpace(data.ParentEmail)">
                        <i class="fas fa-envelope me-2"></i>@Localizer["FiscalAttestation.SendToParent"]
                    </button>
                </form>
            </div>
        }
    }
</div>
