@model (List<Cedeva.Website.Features.PublicRegistration.ViewModels.ActivityWeekOption> Weeks, List<int> Selected)
@* Day-by-day registration: one checkbox per active day, grouped by week. Posts SelectedDays. *@
@{
    var culture = System.Globalization.CultureInfo.CurrentUICulture;
}
<div class="mb-4">
    @foreach (var week in Model.Weeks)
    {
        @if (Model.Weeks.Count > 1)
        {
            <div class="fw-semibold mt-2">@Localizer["PublicRegistration.WeekLabel", week.WeekNumber]</div>
        }
        <div class="d-flex flex-wrap gap-3">
            @foreach (var day in week.Days)
            {
                <div class="form-check">
                    <input type="checkbox" name="SelectedDays" value="@day.DayId" class="form-check-input"
                           id="day_@day.DayId" checked="@(Model.Selected.Contains(day.DayId))" />
                    <label class="form-check-label" for="day_@day.DayId">@day.Date.ToString("ddd dd/MM", culture)</label>
                </div>
            }
        </div>
    }
    @Html.ValidationMessage("SelectedDays", new { @class = "text-danger d-block" })
</div>
