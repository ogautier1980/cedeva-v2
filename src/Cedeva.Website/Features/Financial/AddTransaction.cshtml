@model Cedeva.Website.Features.Financial.ViewModels.AddTransactionViewModel
@inject IStringLocalizer<SharedResources> Localizer
@using Cedeva.Website.Localization

@{
    ViewData["Title"] = Localizer["Financial.AddTransaction"];
    ViewData["ActivityId"] = Model.ActivityId;
    ViewData["ActivityName"] = Model.ActivityName;
    ViewData["NavSection"] = "Financial";
    ViewData["NavAction"] = "Transactions";
    var nextTicketNumber = ViewBag.NextTicketNumber as int? ?? 1;
    var categories = (ViewBag.ExpenseCategories as List<string>) ?? new List<string>();
}

<div class="container-fluid py-4">
    <div class="row mb-4">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h1 class="h3 mb-2">
                        <i class="fas fa-plus me-2"></i>@Localizer["Financial.AddTransaction"]
                    </h1>
                    <p class="text-muted mb-0">
                        <strong>@Localizer["Field.Activity"]:</strong> @Model.ActivityName
                    </p>
                </div>
                <a asp-action="Transactions" class="btn btn-outline-secondary">
                    <i class="fas fa-arrow-left me-1"></i>@Localizer["Button.Back"]
                </a>
            </div>
        </div>
    </div>

    @await Html.PartialAsync("_AlertMessages")

    @* Field names are unprefixed: the form posts to CreateExpense(ExpenseViewModel). The amount is
       typed either in the green Recette box or in the red Dépense box; the script copies it into
       Amount/IsIncome. Team-member reimbursements and consumptions are entered from the member sheet. *@
    <div class="card mb-4">
        <div class="card-body">
            <form asp-controller="Financial" asp-action="CreateExpense" method="post" id="transactionForm">
                @Html.AntiForgeryToken()
                <input type="hidden" name="ActivityId" value="@Model.ActivityId" />
                <input type="hidden" name="Amount" id="Amount" value="" />
                <input type="hidden" name="IsIncome" id="IsIncome" value="false" />

                <div class="row">
                    <div class="col-md-4 mb-3">
                        <label for="ExpenseDate" class="form-label">@Localizer["Field.Date"]</label>
                        <input type="date" name="ExpenseDate" id="ExpenseDate" class="form-control" required
                               value="@Model.Expense.ExpenseDate.ToString("yyyy-MM-dd")" />
                    </div>
                    <div class="col-md-8 mb-3">
                        <label for="Label" class="form-label">@Localizer["Expense.Label"]</label>
                        <input type="text" name="Label" id="Label" class="form-control" required maxlength="100" />
                    </div>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-4">
                        <div class="border rounded p-3 h-100 bg-success-subtle border-success">
                            <label for="IncomeAmount" class="form-label fw-bold text-success">
                                <i class="fas fa-arrow-down me-1"></i>@Localizer["Financial.Receipt"]
                            </label>
                            <div class="input-group">
                                <input type="text" inputmode="decimal" id="IncomeAmount" class="form-control amount-box" autocomplete="off" />
                                <span class="input-group-text">€</span>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="border rounded p-3 h-100 bg-danger-subtle border-danger">
                            <label for="OutgoingAmount" class="form-label fw-bold text-danger">
                                <i class="fas fa-arrow-up me-1"></i>@Localizer["Financial.Outgoing"]
                            </label>
                            <div class="input-group">
                                <input type="text" inputmode="decimal" id="OutgoingAmount" class="form-control amount-box" autocomplete="off" />
                                <span class="input-group-text">€</span>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="border rounded p-3 h-100 bg-light">
                            <span class="form-label fw-bold text-muted d-block">@Localizer["Financial.TicketNumber"]</span>
                            <span class="fs-4 fw-bold">#@nextTicketNumber</span>
                        </div>
                    </div>
                </div>
                <div class="text-danger small mb-3 d-none" id="amountError">@Localizer["Financial.ReceiptOrOutgoingRequired"]</div>

                <div class="row">
                    <div class="col-md-4 mb-3">
                        <span class="form-label d-block">@Localizer["Financial.PaidBy"]</span>
                        <div class="form-check form-check-inline">
                            <input type="radio" name="AssignedTo" value="OrganizationCash" id="PaidByCash" class="form-check-input" checked />
                            <label for="PaidByCash" class="form-check-label">@Localizer["Financial.PaidByCash"]</label>
                        </div>
                        <div class="form-check form-check-inline">
                            <input type="radio" name="AssignedTo" value="OrganizationCard" id="PaidByAccount" class="form-check-input" />
                            <label for="PaidByAccount" class="form-check-label">@Localizer["Financial.PaidByAccount"]</label>
                        </div>
                    </div>
                    <div class="col-md-8 mb-3">
                        <label for="Category" class="form-label">@Localizer["Expense.Category"]</label>
                        <select name="Category" id="Category" class="form-select">
                            <option value="">@Localizer["Expense.SelectCategory"]</option>
                            @foreach (var cat in categories)
                            {
                                <option value="@cat">@cat</option>
                            }
                        </select>
                    </div>
                </div>

                <div class="mb-3">
                    <label for="Description" class="form-label">@Localizer["Financial.Explanations"]</label>
                    <textarea name="Description" id="Description" class="form-control" rows="3" maxlength="500"></textarea>
                </div>

                <div class="d-flex justify-content-end mt-4">
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-save me-1"></i>@Localizer["Button.Save"]
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            CedevaChoices.initAll('.form-select');
        });

        (function () {
            const income = document.getElementById('IncomeAmount');
            const outgoing = document.getElementById('OutgoingAmount');
            const error = document.getElementById('amountError');

            // Only one box holds the amount: typing in one clears the other.
            income.addEventListener('input', () => { if (income.value) outgoing.value = ''; });
            outgoing.addEventListener('input', () => { if (outgoing.value) income.value = ''; });

            document.getElementById('transactionForm').addEventListener('submit', function (e) {
                const isIncome = income.value.trim() !== '';
                const value = (isIncome ? income.value : outgoing.value).trim();
                if (!value) {
                    e.preventDefault();
                    error.classList.remove('d-none');
                    return;
                }
                // Server-side DecimalModelBinder accepts both "," and "." as decimal separator.
                document.getElementById('Amount').value = value;
                document.getElementById('IsIncome').value = isIncome ? 'true' : 'false';
            });
        })();
    </script>
}
