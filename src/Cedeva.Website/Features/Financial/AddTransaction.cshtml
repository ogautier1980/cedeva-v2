@model Cedeva.Website.Features.Financial.ViewModels.AddTransactionViewModel
@inject IStringLocalizer<SharedResources> Localizer
@using Cedeva.Website.Localization
@using Cedeva.Core.Enums

@{
    ViewData["Title"] = Localizer["Financial.AddTransaction"];
    ViewData["ActivityId"] = Model.ActivityId;
    ViewData["ActivityName"] = Model.ActivityName;
    ViewData["NavSection"] = "Financial";
    ViewData["NavAction"] = "Transactions";
}

<div class="container-fluid py-4">
    <div class="row mb-4">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h1 class="h3 mb-2">
                        <i class="fas fa-plus me-2"></i>@Localizer["Financial.AddTransaction"]
                    </h1>
                    <p class="text-muted mb-0">
                        <strong>@Localizer["Field.Activity"]:</strong> @Model.ActivityName
                    </p>
                </div>
                <a asp-action="Transactions" class="btn btn-outline-secondary">
                    <i class="fas fa-arrow-left me-1"></i>@Localizer["Button.Back"]
                </a>
            </div>
        </div>
    </div>

    @await Html.PartialAsync("_AlertMessages")

    <ul class="nav nav-tabs" id="transactionTypeTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active" id="payment-tab" data-bs-toggle="tab" data-bs-target="#payment-pane" type="button" role="tab" aria-controls="payment-pane" aria-selected="true">
                <i class="fas fa-hand-holding-usd me-1 text-success"></i>@Localizer["Payments.AddPayment"]
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="expense-tab" data-bs-toggle="tab" data-bs-target="#expense-pane" type="button" role="tab" aria-controls="expense-pane" aria-selected="false">
                <i class="fas fa-receipt me-1 text-danger"></i>@Localizer["Expense.AddExpense"]
            </button>
        </li>
    </ul>

    <div class="tab-content border border-top-0 rounded-bottom p-3 mb-4" id="transactionTypeTabsContent">
        <div class="tab-pane fade show active" id="payment-pane" role="tabpanel" aria-labelledby="payment-tab" tabindex="0">
            @if (!Model.OutstandingBookings.Any())
            {
                <div class="alert alert-info mb-0">
                    <i class="fas fa-info-circle me-2"></i>@Localizer["Payments.AllBookingsPaid"]
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead class="table-light">
                            <tr>
                                <th scope="col">@Localizer["Field.Child"]</th>
                                <th scope="col">@Localizer["Field.Parent"]</th>
                                <th scope="col" class="text-end">@Localizer["Field.TotalAmount"]</th>
                                <th scope="col" class="text-end">@Localizer["Payments.PaidAmount"]</th>
                                <th scope="col" class="text-end">@Localizer["Payments.RemainingAmount"]</th>
                                <th scope="col">@Localizer["Field.Status"]</th>
                                <th scope="col" class="text-center">@Localizer["Field.Actions"]</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var booking in Model.OutstandingBookings)
                            {
                                <tr>
                                    <td>@booking.ChildName</td>
                                    <td>@booking.ParentName</td>
                                    <td class="text-end">@booking.TotalAmount.ToString("N2") €</td>
                                    <td class="text-end text-success">@booking.PaidAmount.ToString("N2") €</td>
                                    <td class="text-end">
                                        <strong class="text-danger">@booking.RemainingAmount.ToString("N2") €</strong>
                                    </td>
                                    <td>
                                        @if (booking.PaymentStatus == PaymentStatus.NotPaid)
                                        {
                                            <span class="badge bg-danger">@Localizer["PaymentStatus.NotPaid"]</span>
                                        }
                                        else if (booking.PaymentStatus == PaymentStatus.PartiallyPaid)
                                        {
                                            <span class="badge bg-warning">@Localizer["PaymentStatus.PartiallyPaid"]</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        <a asp-controller="Payments" asp-action="Create" asp-route-bookingId="@booking.Id" class="btn btn-sm btn-primary">
                                            <i class="fas fa-plus me-1"></i>@Localizer["Payments.CreatePayment"]
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>

        <div class="tab-pane fade" id="expense-pane" role="tabpanel" aria-labelledby="expense-tab" tabindex="0">
            <form asp-controller="Financial" asp-action="CreateExpense" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Expense.ActivityId" />

                <div class="mb-3">
                    <label for="Label" class="form-label">@Localizer["Expense.Label"]</label>
                    <input asp-for="Expense.Label" class="form-control" id="Label" />
                    <span asp-validation-for="Expense.Label" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label for="Description" class="form-label">@Localizer["Field.Description"]</label>
                    <textarea asp-for="Expense.Description" class="form-control" rows="3" id="Description"></textarea>
                    <span asp-validation-for="Expense.Description" class="text-danger"></span>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label for="Amount" class="form-label">@Localizer["Field.Amount"]</label>
                        <div class="input-group">
                            <input asp-for="Expense.Amount" class="form-control" step="0.01" id="Amount" />
                            <span class="input-group-text">€</span>
                        </div>
                        <span asp-validation-for="Expense.Amount" class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label for="ExpenseDate" class="form-label">@Localizer["Expense.ExpenseDate"]</label>
                        <input asp-for="Expense.ExpenseDate" class="form-control" type="date" id="ExpenseDate" />
                        <span asp-validation-for="Expense.ExpenseDate" class="text-danger"></span>
                    </div>
                </div>

                <div class="mb-3">
                    <label for="Category" class="form-label">@Localizer["Expense.Category"]</label>
                    <input asp-for="Expense.Category" class="form-control" id="Category" list="expenseCategoriesList" autocomplete="off" />
                    <datalist id="expenseCategoriesList">
                        @foreach (var cat in (ViewBag.ExpenseCategories as List<string>) ?? new List<string>())
                        {
                            <option value="@cat"></option>
                        }
                    </datalist>
                    <small class="form-text text-muted">@Localizer["Expense.CategoryHelp"]</small>
                    <span asp-validation-for="Expense.Category" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label for="AssignedTo" class="form-label">@Localizer["Expense.AssignedTo"]</label>
                    <select asp-for="Expense.AssignedTo" class="form-select" asp-items="ViewBag.AssignedToList" id="AssignedTo">
                        <option value="">@Localizer["Expense.SelectAssignedTo"]</option>
                    </select>
                    <span asp-validation-for="Expense.AssignedTo" class="text-danger"></span>
                </div>

                <div class="mb-3" id="expenseTypeDiv" style="display: none;">
                    <label for="ExpenseType" class="form-label">@Localizer["Expense.ExpenseType"]</label>
                    <select asp-for="Expense.ExpenseType" class="form-select" id="ExpenseType">
                        <option value="">@Localizer["Expense.SelectType"]</option>
                        <option value="@ExpenseType.Reimbursement">@Localizer["ExpenseType.Reimbursement"]</option>
                        <option value="@ExpenseType.PersonalConsumption">@Localizer["ExpenseType.PersonalConsumption"]</option>
                    </select>
                    <small class="form-text text-muted">@Localizer["Expense.ExpenseTypeHelp"]</small>
                </div>

                <div class="d-flex justify-content-end mt-4">
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-save me-1"></i>@Localizer["Button.Save"]
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        $(document).ready(function() {
            CedevaChoices.initAll('.form-select');
        });

        document.getElementById('AssignedTo').addEventListener('change', function() {
            const value = this.value;
            const expenseTypeDiv = document.getElementById('expenseTypeDiv');

            if (value && !isNaN(value)) {
                expenseTypeDiv.style.display = 'block';
            } else {
                expenseTypeDiv.style.display = 'none';
            }
        });
    </script>
}
