# Copy to .env on the VPS and fill in real values. Never commit the real .env.
POSTGRES_USER=cedeva
POSTGRES_PASSWORD=change-me
POSTGRES_DB=Cedeva

# Optional — leave empty to boot with email/payments disabled (Brevo/Stripe degrade gracefully
# except AddHttpClient requires the Brevo keys to be non-null, empty string is fine).
Brevo__ApiKey=
Stripe__SecretKey=
Stripe__WebhookSecret=
